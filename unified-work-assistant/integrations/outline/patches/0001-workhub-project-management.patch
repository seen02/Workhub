+import { useCallback, useEffect, useRef, useState } from "react";
+import { toast } from "sonner";
+import type { TaskSelection } from "@shared/editor/lib/taskSelection";
+import env from "~/env";
+import useStores from "~/hooks/useStores";
+import type Document from "~/models/Document";
+import { client } from "~/utils/ApiClient";
+import WorkhubTaskCreate, {
+  type TaskCreateContext,
+  type TaskSourceDisplay,
+} from ".";
+
+interface SelectionContext extends TaskCreateContext {
+  parentId: string;
+  reason?: string;
+}
+interface Target {
+  document: Document;
+  context: SelectionContext;
+  source: TaskSourceDisplay;
+}
+
+/** Keep the task modal outside the transient selection toolbar's lifecycle. */
+export function useSelectionTaskCreate(
+  sourceDocument: Document | undefined,
+  enabled: boolean
+) {
+  const { documents } = useStores();
+  const [target, setTarget] = useState<Target>();
+  const opening = useRef(false);
+  const generation = useRef(0);
+  const supported = !!(
+    enabled &&
+    env.OUTLINE_TASK_CREATION_ENABLED &&
+    sourceDocument?.collectionId &&
+    !sourceDocument.isDraft &&
+    !sourceDocument.isArchived &&
+    !sourceDocument.isDeleted
+  );
+  const sourceId = sourceDocument?.id;
+  useEffect(() => {
+    generation.current += 1;
+    setTarget(undefined);
+    return () => {
+      generation.current += 1;
+    };
+  }, [sourceId, supported]);
+
+  const handleCreateTask = useCallback(
+    async (selection: TaskSelection) => {
+      if (!supported || !sourceDocument || opening.current || target) {
+        return;
+      }
+      if (selection.quote.length > 10000) {
+        toast.error(
+          "선택한 내용은 10,000자까지 등록할 수 있습니다. 선택 범위를 줄여주세요."
+        );
+        return;
+      }
+      const current = generation.current;
+      // Capture before any asynchronous request or modal focus change.
+      const source: TaskSourceDisplay = {
+        ...selection,
+        documentId: sourceDocument.id,
+        revision: sourceDocument.revision,
+        title: sourceDocument.titleWithDefault,
+        url: sourceDocument.url,
+      };
+      opening.current = true;
+      const loadingId = toast.loading("업무 등록 창을 여는 중…");
+      try {
+        const response = await client.post<{ data: SelectionContext }>(
+          "/workhub.taskSelectionInfo",
+          { documentId: source.documentId },
+          { retry: false }
+        );
+        if (generation.current !== current) {
+          return;
+        }
+        if (!response?.data?.eligible) {
+          throw new Error(
+            response?.data?.reason ||
+              "이 문서의 프로젝트에 업무를 등록할 권한이 없습니다."
+          );
+        }
+        const document = await documents.fetch(response.data.parentId);
+        if (generation.current === current) {
+          setTarget({ document, context: response.data, source });
+        }
+      } catch (error) {
+        if (generation.current === current) {
+          toast.error(
+            error instanceof Error
+              ? error.message
+              : "업무 등록 정보를 확인하지 못했습니다. 다시 시도하세요."
+          );
+        }
+      } finally {
+        toast.dismiss(loadingId);
+        opening.current = false;
+      }
+    },
+    [supported, sourceDocument, documents, target]
+  );
+
+  return {
+    onCreateTask: supported ? handleCreateTask : undefined,
+    dialog: target ? (
+      <WorkhubTaskCreate
+        key={`${target.document.id}:${target.source.documentId}`}
+        document={target.document}
+        initialContext={target.context}
+        initialSource={target.source}
+        initiallyOpen
+        hideTrigger
+        onClose={() => setTarget(undefined)}
+      />
+    ) : null,
+  };
+}
