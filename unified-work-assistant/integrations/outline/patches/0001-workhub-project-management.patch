+import Router from "koa-router";
+import { createHash, createHmac, randomUUID } from "node:crypto";
+import { z } from "zod";
+import auth from "@server/middlewares/authentication";
+import validate from "@server/middlewares/validate";
+import timeout from "@server/middlewares/timeout";
+import { rateLimiter } from "@server/middlewares/rateLimiter";
+import { Collection } from "@server/models";
+import { authorize } from "@server/policies";
+import type { APIContext } from "@server/types";
+import { BaseSchema } from "./schema";
+
+const schema = BaseSchema.extend({
+  body: z
+    .object({
+      collectionId: z.string().uuid().optional(),
+      owner: z.string().email().max(254).optional(),
+      managed: z.boolean().optional(),
+      horizon: z.union([z.literal(7), z.literal(30)]).optional(),
+    })
+    .strict(),
+});
+interface BridgeResponse {
+  detail?: string;
+}
+const router = new Router();
+const actions = {
+  analyticsCapabilities: "capabilities",
+  analyticsQuery: "query",
+  analyticsRefresh: "refresh",
+};
+
+for (const [method, action] of Object.entries(actions)) {
+  router.post(
+    `workhub.${method}`,
+    auth(),
+    timeout(action === "refresh" ? 65000 : 20000),
+    rateLimiter({ duration: 60, requests: action === "refresh" ? 6 : 60 }),
+    validate(schema),
+    async (ctx: APIContext<z.infer<typeof schema>>) => {
+      if (process.env.OUTLINE_ANALYTICS_ENABLED !== "true") {
+        ctx.throw(404, "진행 통계가 활성화되지 않았습니다.");
+      }
+      const { user } = ctx.state.auth;
+      const input = ctx.input.body;
+      if (input.collectionId) {
+        const collection = await Collection.findByPk(input.collectionId, {
+          userId: user.id,
+          rejectOnEmpty: true,
+        });
+        authorize(user, "readDocument", collection);
+      }
+      const path = `/internal/outline-analytics/${action}`;
+      const raw = JSON.stringify({
+        ...input,
+        actor: { outlineUserId: user.id, outlineTeamId: user.teamId },
+      });
+      const stamp = Math.floor(Date.now() / 1000).toString();
+      const nonce = randomUUID();
+      const secret = process.env.OUTLINE_WORKHUB_BRIDGE_SECRET;
+      const base = process.env.WORKHUB_INTERNAL_URL;
+      if (!secret || !base) {
+        ctx.throw(503, "통계 서버 연결을 확인하세요.");
+        return;
+      }
+      const signature = createHmac("sha256", secret)
+        .update(
+          [
+            "POST",
+            path,
+            stamp,
+            nonce,
+            createHash("sha256").update(raw).digest("hex"),
+          ].join("\n")
+        )
+        .digest("hex");
+      let response;
+      try {
+        response = await fetch(base + path, {
+          method: "POST",
+          body: raw,
+          headers: {
+            "Content-Type": "application/json",
+            "X-Workhub-Time": stamp,
+            "X-Workhub-Nonce": nonce,
+            "X-Workhub-Signature": signature,
+          },
+          signal: AbortSignal.timeout(action === "refresh" ? 60000 : 15000),
+        });
+        const data: BridgeResponse = await response.json();
+        if (!response.ok) {
+          ctx.throw(
+            response.status,
+            typeof data.detail === "string"
+              ? data.detail
+              : "통계를 확인하지 못했습니다."
+          );
+        }
+        ctx.set("Cache-Control", "no-store");
+        ctx.body = { data };
+      } catch (error) {
+        if (error instanceof Error && "status" in error) {
+          throw error;
+        }
+        ctx.throw(
+          503,
+          "통계 서버의 응답을 확인하지 못했습니다. 다시 시도해 주세요."
+        );
+      }
+    }
+  );
+}
+export default router;
