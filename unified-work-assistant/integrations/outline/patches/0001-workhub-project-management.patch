+import { action, computed, observable, runInAction } from "mobx";
+import { client as api } from "~/utils/ApiClient";
+import {
+  AuthorizationError,
+  BadRequestError,
+  NotFoundError,
+  RateLimitExceededError,
+  UnprocessableEntityError,
+} from "~/utils/errors";
+import type {
+  AnalyticsData,
+  AnalyticsViewer,
+  ScheduleSelection,
+} from "~/scenes/WorkhubAnalytics/types";
+import { overlaps } from "~/scenes/WorkhubAnalytics/calendar";
+
+/** Session-only statistics state; cleared by RootStore on logout and team change. */
+export class WorkhubAnalyticsStore {
+  @observable.ref data: AnalyticsData | undefined;
+  @observable.ref viewer: AnalyticsViewer | undefined;
+  @observable eligible: boolean | undefined;
+  @observable linkedIds: string[] = [];
+  @observable error = "";
+  @observable capabilityError = "";
+  @observable busy = false;
+  @observable refreshing = false;
+  @observable managed = false;
+  @observable collectionId = "";
+  @observable owner = "";
+  @observable horizon = 7;
+  @observable focus = "all";
+  @observable search = "";
+  @observable page = 1;
+  @observable calendarMode: "week" | "month" = "week";
+  @observable anchor = "";
+  @observable.ref selection: ScheduleSelection | undefined;
+  @observable notice = "";
+  private identity = "";
+  private request = 0;
+  private capabilityRequest = 0;
+  private checkedAt = 0;
+  private retryAt = 0;
+  private routeValid = true;
+
+  /** Reset all sensitive data and invalidate pending responses. */
+  @action clear() {
+    this.request++;
+    this.capabilityRequest++;
+    this.identity = "";
+    this.data = undefined;
+    this.viewer = undefined;
+    this.eligible = undefined;
+    this.linkedIds = [];
+    this.error = "";
+    this.capabilityError = "";
+    this.busy = false;
+    this.refreshing = false;
+    this.owner = "";
+    this.managed = false;
+    this.collectionId = "";
+    this.horizon = 7;
+    this.calendarMode = "week";
+    this.search = "";
+    this.focus = "all";
+    this.page = 1;
+    this.anchor = "";
+    this.selection = undefined;
+    this.notice = "";
+    this.checkedAt = 0;
+    this.retryAt = 0;
+    this.routeValid = true;
+  }
+
+  /** Verify current viewer and linked project IDs for menus without requiring a portal session. */
+  async initialize(identity: string, force = false) {
+    if (identity !== this.identity) {
+      this.clear();
+      this.identity = identity;
+    }
+    if (!force && this.viewer) {
+      return;
+    }
+    const sequence = ++this.capabilityRequest;
+    try {
+      const response = await api.post<{ data: AnalyticsViewer }>(
+        "/workhub.analyticsCapabilities",
+        {},
+        { retry: false }
+      );
+      if (sequence !== this.capabilityRequest) {
+        return;
+      }
+      runInAction(() => {
+        this.viewer = response.data;
+        this.owner = response.data.email;
+        this.eligible = true;
+        this.capabilityError = "";
+        this.linkedIds = response.data.linked_ids ?? [];
+      });
+    } catch (error) {
+      if (sequence !== this.capabilityRequest) {
+        return;
+      }
+      runInAction(() => {
+        this.capabilityError =
+          error instanceof Error
+            ? error.message || "이용 자격을 확인하지 못했습니다."
+            : "이용 자격을 확인하지 못했습니다.";
+        if (
+          error instanceof AuthorizationError ||
+          error instanceof NotFoundError
+        ) {
+          this.eligible = false;
+          this.data = undefined;
+          this.linkedIds = [];
+        }
+      });
+    }
+  }
+
+  /** Apply validated URL conditions and fetch the corresponding range. */
+  @action applyRoute(search: string) {
+    if (!this.viewer) {
+      return;
+    }
+    const params = new URLSearchParams(search),
+      scope = params.get("scope") ?? this.viewer.default_scope;
+    const collectionId = params.get("collectionId") ?? "",
+      horizon = params.get("horizon") ?? "7";
+    if (
+      !["all", "managed"].includes(scope) ||
+      !["7", "30"].includes(horizon) ||
+      (collectionId &&
+        !/^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i.test(
+          collectionId
+        ))
+    ) {
+      this.request++;
+      this.routeValid = false;
+      this.data = undefined;
+      this.error = "조회 주소의 조건을 확인해 주세요.";
+      this.busy = false;
+      this.refreshing = false;
+      return;
+    }
+    this.routeValid = true;
+    const changed =
+      this.collectionId !== collectionId ||
+      this.managed !== (scope === "managed");
+    this.collectionId = collectionId;
+    this.managed = scope === "managed";
+    this.horizon = Number(horizon);
+    if (!this.viewer.admin) {
+      this.owner = this.viewer.email;
+    }
+    if (changed) {
+      this.owner = this.viewer.email;
+      this.notice = "";
+      this.selection = undefined;
+      this.page = 1;
+    }
+    void this.load();
+  }
+
+  /** Load current conditions; late responses can never replace another range. */
+  async load(background = false, refresh = false) {
+    if (!this.routeValid) {
+      return;
+    }
+    if (this.viewer && !this.viewer.admin) {
+      runInAction(() => {
+        this.owner = this.viewer?.email ?? "";
+      });
+    }
+    if (background && (this.busy || Date.now() < this.retryAt)) {
+      this.expire();
+      return;
+    }
+    const sequence = ++this.request;
+    if (!background) {
+      runInAction(() => {
+        this.data = undefined;
+        this.error = "";
+      });
+    }
+    runInAction(() => {
+      this.busy = true;
+      this.refreshing = refresh;
+    });
+    const input = {
+      ...(this.collectionId ? { collectionId: this.collectionId } : {}),
+      ...(this.owner ? { owner: this.owner } : {}),
+      managed: this.managed,
+      horizon: this.horizon,
+    };
+    try {
+      const response = await api.post<{ data: AnalyticsData }>(
+        refresh ? "/workhub.analyticsRefresh" : "/workhub.analyticsQuery",
+        input,
+        { retry: false }
+      );
+      if (sequence !== this.request) {
+        return;
+      }
+      runInAction(() => {
+        this.data = response.data;
+        this.viewer = response.data.viewer;
+        this.owner = response.data.owner;
+        this.linkedIds = response.data.linked_ids;
+        this.eligible = true;
+        this.error = "";
+        this.capabilityError = "";
+        this.checkedAt = Date.now();
+        this.retryAt = 0;
+        if (!this.anchor) {
+          this.anchor = response.data.as_of;
+        }
+        this.page = Math.min(
+          this.page,
+          Math.max(1, Math.ceil(this.filteredTasks.length / 20))
+        );
+      });
+    } catch (error) {
+      if (sequence !== this.request) {
+        return;
+      }
+      runInAction(() => {
+        const fatal =
+          error instanceof AuthorizationError ||
+          error instanceof NotFoundError ||
+          error instanceof BadRequestError ||
+          error instanceof UnprocessableEntityError;
+        if (fatal || !background) {
+          this.data = undefined;
+        }
+        if (error instanceof AuthorizationError) {
+          this.linkedIds = [];
+        }
+        if (error instanceof RateLimitExceededError) {
+          this.retryAt = Date.now() + 60000;
+        }
+        this.error =
+          error instanceof Error
+            ? error.message || "통계를 확인하지 못했습니다."
+            : "통계를 확인하지 못했습니다.";
+        this.expire();
+      });
+    } finally {
+      if (sequence === this.request) {
+        runInAction(() => {
+          this.busy = false;
+          this.refreshing = false;
+        });
+      }
+    }
+  }
+
+  /** Drop cached values when current permissions cannot be checked for two minutes. */
+  @action expire() {
+    if (this.data && Date.now() - this.checkedAt >= 120000) {
+      this.data = undefined;
+      this.error =
+        "권한과 통계를 다시 확인해 주세요. 마지막 확인 후 2분이 지났습니다.";
+    }
+  }
+
+  /** Change the person condition while retaining the project range. */
+  @action selectOwner(email: string) {
+    if (this.viewer && !this.viewer.admin && email !== this.viewer.email) {
+      return;
+    }
+    this.owner = email;
+    this.focus = "all";
+    this.page = 1;
+    this.selection = undefined;
+    void this.load();
+  }
+
+  /** Open the role-specific default when the main statistics menu is clicked. */
+  @action openDefault() {
+    this.owner = this.viewer?.email ?? "";
+    this.focus = "all";
+    this.search = "";
+    this.page = 1;
+    this.selection = undefined;
+    this.anchor = "";
+    this.calendarMode = "week";
+    this.applyRoute("");
+  }
+
+  /** Apply an in-memory list condition without a server round trip. */
+  @action inspect(focus: string, selection?: ScheduleSelection) {
+    this.focus = focus;
+    this.selection = selection;
+    this.page = 1;
+    this.search = "";
+  }
+
+  /** Resolve only the names included in the permitted response. */
+  name(email: string): string {
+    return (
+      this.data?.names[email.toLowerCase()] ??
+      (email === this.viewer?.email ? this.viewer.name : email)
+    );
+  }
+
+  /** Overview cards use every permitted task for administrators. */
+  @computed get overviewSummary() {
+    return this.viewer?.admin
+      ? (this.data?.portfolio?.summary ?? this.data?.summary)
+      : this.data?.summary;
+  }
+
+  /** Project overview ignores the administrator's person focus. */
+  @computed get overviewProjects() {
+    return this.viewer?.admin
+      ? (this.data?.portfolio?.projects ?? this.data?.projects ?? [])
+      : (this.data?.projects ?? []);
+  }
+
+  /** Match an overview card's list to its unfiltered administrator count. */
+  @action inspectOverview(focus: string) {
+    if (this.viewer?.admin && this.owner) {
+      this.selectOwner("");
