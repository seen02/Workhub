+import Router from "koa-router";
+import { createHash, createHmac, randomUUID } from "node:crypto";
+import { Op } from "sequelize";
+import { z } from "zod";
+import auth from "@server/middlewares/authentication";
+import validate from "@server/middlewares/validate";
+import timeout from "@server/middlewares/timeout";
+import { rateLimiter } from "@server/middlewares/rateLimiter";
+import { Collection, Document } from "@server/models";
+import { authorize, can } from "@server/policies";
+import type { APIContext } from "@server/types";
+import { BaseSchema } from "./schema";
+
+export const taskEditChanges = z
+  .object({
+    owner: z.string().email().max(200).optional(),
+    start: z.string().max(10).optional(),
+    due: z.string().max(10).optional(),
+    shiftDays: z.number().int().min(-3660).max(3660).optional(),
+    shiftBoth: z.boolean().optional(),
+    transferCriteria: z.boolean().optional(),
+    reopen: z.boolean().optional(),
+    criteria: z
+      .array(
+        z
+          .object({
+            id: z.string().max(20),
+            title: z.string().min(2).max(160),
+            owner: z.string().email().max(200),
+          })
+          .strict()
+      )
+      .max(40)
+      .optional(),
+  })
+  .strict();
+
+const schema = BaseSchema.extend({
+  body: z
+    .object({
+      collectionId: z.string().uuid(),
+      parentDocumentId: z.string().uuid(),
+      documentId: z.string().uuid().optional(),
+      requestId: z.string().uuid().optional(),
+      revision: z.number().int().nonnegative().optional(),
+      updatedAt: z.string().max(100).optional(),
+      status: z.enum(["미착수", "진행 중", "보류", "지연", "완료"]).optional(),
+      criterionId: z.string().max(200).optional(),
+      criterionState: z.enum(["예정", "진행 중", "완료"]).optional(),
+      edits: z
+        .array(
+          z
+            .object({
+              documentId: z.string().uuid(),
+              revision: z.number().int().nonnegative(),
+              updatedAt: z.string().min(1).max(100),
+              changes: taskEditChanges,
+            })
+            .strict()
+        )
+        .min(1)
+        .max(100)
+        .optional(),
+    })
+    .strict(),
+});
+interface Grant {
+  id: string;
+  canUpdate: boolean;
+}
+interface BridgeResponse {
+  detail?: string;
+}
+const router = new Router();
+for (const [method, action] of Object.entries({
+  kanbanInfo: "info",
+  kanbanQuery: "query",
+  kanbanMutate: "mutate",
+  taskEditPreview: "preview",
+  taskEdit: "edit",
+  taskEditUndo: "undo",
+})) {
+  router.post(
+    `workhub.${method}`,
+    auth(),
+    timeout(65000),
+    rateLimiter({ duration: 60, requests: 60 }),
+    validate(schema),
+    async (ctx: APIContext<z.infer<typeof schema>>) => {
+      if (process.env.OUTLINE_KANBAN_ENABLED !== "true") {
+        ctx.throw(404, "칸반이 활성화되지 않았습니다.");
+      }
+      const { user } = ctx.state.auth;
+      const input = ctx.input.body;
+      const collection = await Collection.findByPk(input.collectionId, {
+        userId: user.id,
+        rejectOnEmpty: true,
+      });
+      authorize(user, "readDocument", collection);
+      const parent = await Document.findByPk(input.parentDocumentId, {
+        userId: user.id,
+        rejectOnEmpty: true,
+      });
+      authorize(user, "read", parent);
+      if (
+        parent.collectionId !== collection.id ||
+        parent.parentDocumentId ||
+        !parent.publishedAt ||
+        !parent.isActive ||
+        parent.template
+      ) {
+        ctx.throw(409, "현재 프로젝트의 업무 목록에서 확인하세요.");
+      }
+      let canUpdate = false;
+      let grants: Grant[] = [];
+      const edits = [];
+      if (["preview", "edit", "undo"].includes(action)) {
+        if (
+          !input.requestId ||
+          !input.edits?.length ||
+          new Set(input.edits.map((item) => item.documentId)).size !==
+            input.edits.length
+        ) {
+          ctx.throw(400, "중복 없는 업무와 변경 요청 번호가 필요합니다.");
+          return;
+        }
+        for (const item of input.edits) {
+          const doc = await Document.findByPk(item.documentId, {
+            userId: user.id,
+          });
+          edits.push({
+            ...item,
+            canUpdate:
+              !!doc &&
+              doc.teamId === user.teamId &&
+              doc.collectionId === collection.id &&
+              doc.parentDocumentId === parent.id &&
+              !!doc.publishedAt &&
+              doc.isActive &&
+              !doc.template &&
+              !!can(user, "read", doc) &&
+              !!can(user, "update", doc),
+          });
+        }
+      }
+      if (action === "query") {
+        const children = await Document.withMembershipScope(user.id).findAll({
+          where: {
+            teamId: user.teamId,
+            collectionId: collection.id,
+            parentDocumentId: parent.id,
+            publishedAt: { [Op.ne]: null },
+            archivedAt: null,
+            template: false,
+          },
+          order: [
+            ["createdAt", "ASC"],
+            ["id", "ASC"],
+          ],
+          limit: 1001,
+        });
+        const readable = children.filter((doc) => can(user, "read", doc));
+        if (readable.length > 1000 || children.length > 1000) {
+          ctx.throw(
+            422,
+            "업무가 1,000개를 넘습니다. 업무 목록을 나누어 주세요."
+          );
+        }
+        grants = readable.map((doc) => ({
+          id: doc.id,
+          canUpdate: !!can(user, "update", doc),
+        }));
+      }
+      if (action === "mutate") {
+        if (
+          !input.documentId ||
+          !input.requestId ||
+          input.revision === undefined ||
+          !input.updatedAt
+        ) {
+          ctx.throw(400, "변경 요청과 원본 버전을 확인하세요.");
+          return;
+        }
+        const doc = await Document.findByPk(input.documentId, {
+          userId: user.id,
+          rejectOnEmpty: true,
+        });
+        authorize(user, "read", doc);
+        authorize(user, "update", doc);
+        if (
+          doc.collectionId !== collection.id ||
+          doc.parentDocumentId !== parent.id ||
+          !doc.publishedAt ||
+          !doc.isActive ||
+          doc.template
+        ) {
+          ctx.throw(409, "현재 업무 목록에 속한 업무만 변경할 수 있습니다.");
+        }
+        canUpdate = true;
+      }
+      const path = `/internal/outline-kanban/${action}`;
+      const raw = JSON.stringify({
+        ...input,
+        ...(input.edits ? { edits } : {}),
+        grants,
+        actor: {
+          outlineUserId: user.id,
+          outlineTeamId: user.teamId,
+          canUpdate,
+        },
+      });
+      const stamp = Math.floor(Date.now() / 1000).toString(),
+        nonce = randomUUID();
+      const secret = process.env.OUTLINE_WORKHUB_BRIDGE_SECRET,
+        base = process.env.WORKHUB_INTERNAL_URL;
+      if (!secret || !base) {
+        ctx.throw(503, "업무 서버 연결을 확인하세요.");
+        return;
+      }
+      const signature = createHmac("sha256", secret)
+        .update(
+          [
+            "POST",
+            path,
+            stamp,
+            nonce,
+            createHash("sha256").update(raw).digest("hex"),
+          ].join("\n")
+        )
+        .digest("hex");
+      try {
+        const response = await fetch(base + path, {
+          method: "POST",
+          body: raw,
+          headers: {
+            "Content-Type": "application/json",
+            "X-Workhub-Time": stamp,
+            "X-Workhub-Nonce": nonce,
+            "X-Workhub-Signature": signature,
+          },
+          signal: AbortSignal.timeout(60000),
+        });
+        const data: BridgeResponse = await response.json();
+        if (!response.ok) {
+          ctx.throw(
+            response.status,
+            data.detail || "업무 요청을 처리하지 못했습니다."
+          );
+        }
+        ctx.set("Cache-Control", "no-store");
+        ctx.body = { data };
+      } catch (error) {
+        if (error instanceof Error && "status" in error) {
+          throw error;
+        }
+        ctx.throw(503, "결과를 확인하지 못했습니다. 잠시 후 다시 확인하세요.");
+      }
+    }
+  );
+}
+export default router;
