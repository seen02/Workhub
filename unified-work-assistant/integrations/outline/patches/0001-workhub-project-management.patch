+  url: "/doc/task",
+  owner: "a@example.com",
+  status: "진행 중",
+  progress: "0%",
+  start,
+  due,
+  days_remaining: 0,
+  flags: [],
+  blocker: "없음",
+  next: "점검",
+  next_is_suggestion: true,
+  remaining: 1,
+  criteria: [],
+});
+describe("date-only dashboard calendar", () => {
+  it("handles month and year boundaries without local timezone conversion", () => {
+    expect(addDays("2026-12-31", 1)).toBe("2027-01-01");
+    expect(calendarRange("2026-10-01", "week").from).toBe("2026-09-28");
+    expect(calendarRange("2026-02-10", "month").to).toBe("2026-02-28");
+  });
+  it("includes both endpoints and rejects incomplete or reversed periods", () => {
+    expect(
+      overlaps(task("2026-10-01", "2026-10-03"), "2026-10-03", "2026-10-03")
+    ).toBe(true);
+    expect(
+      overlaps(task("2026-10-03", "2026-10-01"), "2026-10-02", "2026-10-02")
+    ).toBe(false);
+    expect(overlaps(task(null, "2026-10-03"), "2026-10-02", "2026-10-02")).toBe(
+      false
+    );
+  });
+  it("counts peak simultaneous work rather than all tasks touched in a week", () => {
+    expect(
+      peakTasks(
+        [task("2026-10-01", "2026-10-02"), task("2026-10-03", "2026-10-04")],
+        "2026-10-01",
+        "2026-10-07"
+      )
+    ).toBe(1);
+    expect(
+      peakTasks(
+        [task("2026-10-01", "2026-10-03"), task("2026-10-03", "2026-10-04")],
+        "2026-10-01",
+        "2026-10-07"
+      )
+    ).toBe(2);
+  });
+});
