@@ -0,0 +1,155 @@
+import Koa from "koa";
+import { IncomingMessage, ServerResponse } from "node:http";
+import { Socket } from "node:net";
+import { createHash, createHmac, randomUUID } from "node:crypto";
+import { afterEach, beforeEach, describe, expect, it, vi } from "vitest";
+import { CollectionPermission, UserRole } from "@shared/types";
+import {
+  Collection,
+  GroupMembership,
+  Team,
+  User,
+  UserMembership,
+} from "@server/models";
+import router from "./workhub";
+
+describe("signed project management permissions", () => {
+  const teamId = randomUUID();
+  const userId = randomUUID();
+  const collectionId = randomUUID();
+  let collection: Collection;
+  let user: User;
+  const request = vi.fn<typeof fetch>();
+
+  beforeEach(() => {
+    vi.stubEnv("OUTLINE_PROJECT_MANAGEMENT_ENABLED", "true");
+    vi.stubEnv("OUTLINE_WORKHUB_BRIDGE_SECRET", "project-test-secret");
+    vi.stubEnv("WORKHUB_INTERNAL_URL", "http://workhub.invalid");
+    user = User.build({ id: userId, teamId, role: UserRole.Member });
+    user.team = Team.build({ id: teamId, memberCollectionCreate: true });
+    collection = Collection.build({
+      id: collectionId,
+      teamId,
+      permission: CollectionPermission.ReadWrite,
+    });
+    collection.memberships = [];
+    collection.groupMemberships = [];
+    vi.spyOn(Collection, "findByPk").mockResolvedValue(collection);
+    request.mockReset();
+    request.mockImplementation(async () =>
+      Response.json({
+        permissions: { updateManager: false, deleteTaskList: false },
+      })
+    );
+    vi.stubGlobal("fetch", request);
+  });
+
+  afterEach(() => {
+    vi.restoreAllMocks();
+    vi.unstubAllGlobals();
+    vi.unstubAllEnvs();
+  });
+
+  const invoke = async () => {
+    const incoming = new IncomingMessage(new Socket());
+    const ctx = Object.assign(
+      new Koa().createContext(incoming, new ServerResponse(incoming)),
+      {
+        params: {},
+        router,
+        _matchedRoute: "workhub.projectInfo",
+        _matchedRouteName: undefined,
+      }
+    );
+    ctx.state.auth = { user };
+    ctx.input = { body: { collectionId } };
+    const handler = router.stack
+      .find((route) => route.path === "workhub.projectInfo")
+      ?.stack.at(-1);
+    if (!handler) {
+      throw new Error("Missing project info route");
+    }
+    await handler(ctx, async () => {});
+    const [url, options] = request.mock.calls.at(-1) || [];
+    if (typeof options?.body !== "string") {
+      throw new Error("Missing signed bridge request");
+    }
+    return {
+      url,
+      options,
+      actor: JSON.parse(options.body).actor,
+      cacheControl: ctx.response.get("Cache-Control"),
+    };
+  };
+
+  it.each([CollectionPermission.Read, CollectionPermission.ReadWrite])(
+    "does not treat %s access as collection management",
+    async (permission) => {
+      collection.memberships = [
+        UserMembership.build({
+          id: randomUUID(),
+          userId,
+          collectionId,
+          permission,
+        }),
+      ];
+      expect((await invoke()).actor.canManageProject).toBe(false);
+    }
+  );
+
+  it("allows direct collection admin membership for an ordinary member", async () => {
+    collection.memberships = [
+      UserMembership.build({
+        id: randomUUID(),
+        userId,
+        collectionId,
+        permission: CollectionPermission.Admin,
+      }),
+    ];
+    const result = await invoke();
+    expect(user.isAdmin).toBe(false);
+    expect(result.actor.canManageProject).toBe(true);
+    expect(Collection.findByPk).toHaveBeenCalledWith(collectionId, {
+      userId,
+      rejectOnEmpty: true,
+    });
+    expect(result.cacheControl).toBe("no-store");
+  });
+
+  it("uses group admin grants and rechecks after the grant is removed", async () => {
+    collection.groupMemberships = [
+      GroupMembership.build({
+        id: randomUUID(),
+        collectionId,
+        permission: CollectionPermission.Admin,
+      }),
+    ];
+    expect((await invoke()).actor.canManageProject).toBe(true);
+    collection.groupMemberships = [];
+    expect((await invoke()).actor.canManageProject).toBe(false);
+    expect(Collection.findByPk).toHaveBeenCalledTimes(2);
+  });
+
+  it("does not grant collection management through collection creation", async () => {
+    const { actor } = await invoke();
+    expect(actor.canCreateCollection).toBe(true);
+    expect(actor.canManageProject).toBe(false);
+  });
+
+  it("signs the collection and permission together", async () => {
+    const { options } = await invoke();
+    const headers = new Headers(options.headers);
+    const raw = String(options.body);
+    const message = [
+      "POST",
+      "/internal/outline-projects/info",
+      headers.get("X-Workhub-Time"),
+      headers.get("X-Workhub-Nonce"),
+      createHash("sha256").update(raw).digest("hex"),
+    ].join("\n");
+    expect(headers.get("X-Workhub-Signature")).toBe(
+      createHmac("sha256", "project-test-secret").update(message).digest("hex")
+    );
+    expect(JSON.parse(raw).collectionId).toBe(collectionId);
+  });
+});
