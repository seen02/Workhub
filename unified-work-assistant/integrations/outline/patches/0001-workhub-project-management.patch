+    timeout(65000),
+    rateLimiter({ duration: 60, requests: action === "create" ? 20 : 60 }),
+    validate(schema),
+    async (ctx: APIContext<z.infer<typeof schema>>) => {
+      if (process.env.OUTLINE_TASK_CREATION_ENABLED !== "true") {
+        ctx.throw(404, "간편 업무 등록이 활성화되지 않았습니다.");
+      }
+      const { user } = ctx.state.auth;
+      const input = ctx.input.body;
+      const collection = await Collection.findByPk(input.collectionId, {
+        userId: user.id,
+        rejectOnEmpty: true,
+      });
+      authorize(user, "readDocument", collection);
+      const parent = await Document.findByPk(input.parentDocumentId, {
+        userId: user.id,
+        rejectOnEmpty: true,
+      });
+      authorize(user, "read", parent);
+      if (
+        parent.collectionId !== collection.id ||
+        parent.parentDocumentId ||
+        !parent.publishedAt ||
+        parent.isArchived ||
+        parent.isDeleted ||
+        parent.template
+      ) {
+        ctx.throw(409, "현재 프로젝트의 업무 목록에서 등록하세요.");
+      }
