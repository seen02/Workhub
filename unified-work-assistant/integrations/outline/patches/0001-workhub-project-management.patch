+import useCurrentTeam from "~/hooks/useCurrentTeam";
+import useStores from "~/hooks/useStores";
+import SidebarLink from "./SidebarLink";
+
+/** Menu entry whose eligibility follows the current authenticated viewer. */
+export const WorkhubAnalyticsLink = observer(function WorkhubAnalyticsLink() {
+  const user = useCurrentUser(),
+    team = useCurrentTeam(),
+    { workhubAnalytics: store } = useStores();
+  useEffect(() => {
+    if (env.OUTLINE_ANALYTICS_ENABLED) {
+      void store.initialize(user.id + ":" + team.id);
+    }
+  }, [store, user.id, team.id]);
+  if (!env.OUTLINE_ANALYTICS_ENABLED || store.eligible === false) {
+    return null;
+  }
+  return (
+    <SidebarLink
+      to="/workhub/analytics"
+      onClick={() => store.openDefault()}
+      icon={<CollectionIcon />}
+      label={store.capabilityError ? "진행 통계 · 다시 확인" : "진행 통계"}
+      exact={false}
+    />
+  );
+});
