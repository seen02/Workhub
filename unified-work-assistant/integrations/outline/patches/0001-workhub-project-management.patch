+  it("resolves the registered parent and checks real destination policies", async () => {
+    await invoke("workhub.taskSelectionInfo", { documentId: sourceId });
+    expect(
+      request.mock.calls.map(([url]) => String(url).split("/").at(-1))
+    ).toEqual(["resolve", "info"]);
+    const raw = request.mock.calls.at(-1)?.[1]?.body;
