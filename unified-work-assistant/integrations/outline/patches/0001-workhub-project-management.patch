+    if (!source.collectionId) {
+      ctx.throw(422, "원문 문서의 컬렉션을 확인하세요.");
+    }
+    const collection = await Collection.findByPk(source.collectionId, {
+      userId: user.id,
+      rejectOnEmpty: true,
+    });
+    authorize(user, "readDocument", collection);
+    authorize(user, "createDocument", collection);
+    const actor = {
+      outlineUserId: user.id,
+      outlineTeamId: user.teamId,
+      canCreateChild: false,
+    };
+    const resolved = await bridge(ctx, "resolve", {
+      collectionId: collection.id,
+      actor,
+    });
+    if (!resolved.parentId) {
+      ctx.throw(
+        409,
+        "이 컬렉션을 프로젝트로 연결하고 업무 목록을 준비한 뒤 등록하세요."
+      );
+    }
+    const parent = await Document.findByPk(resolved.parentId, {
+      userId: user.id,
+      rejectOnEmpty: true,
+    });
+    authorize(user, "read", parent);
+    const canCreateChild =
+      !!can(user, "createDocument", collection) &&
+      !!can(user, "createChildDocument", parent);
+    const data = await bridge(ctx, "info", {
+      collectionId: collection.id,
+      parentDocumentId: parent.id,
+      actor: { ...actor, canCreateChild },
+    });
