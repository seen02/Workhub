+import { createHash, createHmac, randomUUID } from "node:crypto";
+import { v5 as uuidv5 } from "uuid";
+import { CollectionPermission } from "@shared/types";
+import { Group, GroupMembership, GroupUser } from "@server/models";
+import type { Collection } from "@server/models";
+import { sequelize } from "@server/storage/database";
+import type { APIContext } from "@server/types";
+import { authorize, can } from "@server/policies";
+import { InvalidRequestError } from "@server/errors";
+
+interface LinkAccessInput {
+  collectionId: string;
+  requestId: string;
+  expectedRevision: number;
+  managerSubject?: string | null;
+  deleteTaskList?: boolean;
+  expectedParentId?: string | null;
+}
+
+/**
+ * Return the durable identifier of a grant owned by project creation.
+ *
+ * @param collectionId the collection receiving the automatic grant.
+ * @returns the stable membership identifier.
+ */
+export function projectGroupMembershipId(collectionId: string) {
+  const value = uuidv5(`${collectionId}:workhub-project-group`, uuidv5.URL);
+  return value.slice(0, 14) + "4" + value.slice(15);
+}
+
+/**
+ * Validate the integration group before any collection or grant is created.
+ *
+ * @param ctx the authenticated collection creation context.
+ * @param collection the existing collection, when linking after creation.
+ * @param input the original link request, when checking replay safety.
+ * @returns the group containing the actual API token owner.
+ * @throws when the group or integration account is unavailable.
+ */
+export async function resolveProjectGroup(
+  ctx: APIContext,
+  collection?: Collection,
+  input?: LinkAccessInput
+) {
+  const { user } = ctx.state.auth;
+  const secret = process.env.OUTLINE_WORKHUB_BRIDGE_SECRET;
+  const base = process.env.WORKHUB_INTERNAL_URL;
+  if (
+    process.env.OUTLINE_PROJECT_MANAGEMENT_ENABLED !== "true" ||
+    !secret ||
+    !base
+  ) {
+    throw InvalidRequestError("프로젝트 연동 설정이 필요합니다.");
+  }
+  if (collection) {
+    authorize(user, "update", collection);
+  } else {
+    authorize(user, "createCollection", user.team);
+  }
+  const path = "/internal/outline-projects/connection-group";
+  const timestamp = Math.floor(Date.now() / 1000).toString();
+  const nonce = randomUUID();
+  const raw = JSON.stringify({
+    ...input,
+    actor: {
+      outlineUserId: user.id,
+      outlineTeamId: user.teamId,
+      canCreateCollection: !!can(user, "createCollection", user.team),
+      canManageProject: !!collection && !!can(user, "update", collection),
+    },
+  });
+  const signature = createHmac("sha256", secret)
+    .update(
+      [
+        "POST",
+        path,
+        timestamp,
+        nonce,
+        createHash("sha256").update(raw).digest("hex"),
+      ].join("\n")
+    )
+    .digest("hex");
+  const response = await fetch(base + path, {
+    method: "POST",
+    body: raw,
+    headers: {
+      "Content-Type": "application/json",
+      "X-Workhub-Time": timestamp,
+      "X-Workhub-Nonce": nonce,
+      "X-Workhub-Signature": signature,
+    },
+    signal: AbortSignal.timeout(30000),
+  });
+  const result: {
+    groupId?: string;
+    serviceUserId?: string;
+    detail?: string;
+    skipGrant?: boolean;
+  } = await response.json();
+  if (response.ok && collection && result.skipGrant) {
+    return undefined;
+  }
+  if (!response.ok || !result.groupId || !result.serviceUserId) {
+    throw InvalidRequestError(
+      result.detail || "연동 그룹과 API 키 계정을 확인하지 못했습니다."
+    );
+  }
+  const group = await Group.findOne({
+    where: {
+      id: result.groupId,
+      teamId: user.teamId,
+      name: "Connect_as_a_project",
+    },
+    ...ctx.context,
+  });
+  if (!group) {
+    throw InvalidRequestError("Connect_as_a_project 그룹을 찾을 수 없습니다.");
+  }
+  const member = await GroupUser.findOne({
+    where: { groupId: group.id, userId: result.serviceUserId },
+    ...ctx.context,
+  });
+  if (!member) {
+    throw InvalidRequestError(
+      "Connect_as_a_project 그룹에 API 키를 발급받은 Admin 계정이 없습니다."
+    );
+  }
+  return group;
+}
+
+/**
+ * Add the integration group or temporarily elevate a manual read grant.
+ *
+ * @param ctx the authenticated project link context.
+ * @param collection the collection managed by the caller.
+ * @param input the original link request used for replay checks.
+ * @returns whether a permission was added or elevated.
+ */
+export async function ensureProjectGroup(
+  ctx: APIContext,
+  collection: Collection,
+  input: LinkAccessInput
+) {
+  const group = await resolveProjectGroup(ctx, collection, input);
+  if (!group) {
+    return false;
+  }
+  return sequelize.transaction(async (transaction) => {
+    await sequelize.query("SELECT pg_advisory_xact_lock(hashtext(:id))", {
+      replacements: { id: `workhub-project-group:${collection.id}` },
+      transaction,
+    });
+    const existing = await GroupMembership.findOne({
+      where: { collectionId: collection.id, groupId: group.id },
+      transaction,
+      lock: transaction.LOCK.UPDATE,
+    });
+    if (existing) {
+      if (
+        existing.permission === CollectionPermission.ReadWrite ||
+        existing.permission === CollectionPermission.Admin
+      ) {
+        return false;
+      }
+      existing.workhubPreviousPermission = CollectionPermission.Read;
+      existing.permission = CollectionPermission.ReadWrite;
+      await existing.save({ ...ctx.context, transaction });
+      return true;
+    }
+    const id = projectGroupMembershipId(collection.id);
+    const retired = await GroupMembership.findByPk(id, {
+      transaction,
+      paranoid: false,
+      lock: transaction.LOCK.UPDATE,
+    });
+    if (retired) {
+      await retired.restore({ ...ctx.context, transaction });
+      retired.permission = CollectionPermission.ReadWrite;
+      retired.workhubPreviousPermission = null;
+      await retired.save({ ...ctx.context, transaction });
+    } else {
+      await GroupMembership.create(
+        {
+          id,
+          collectionId: collection.id,
+          groupId: group.id,
+          permission: CollectionPermission.ReadWrite,
+          createdById: ctx.state.auth.user.id,
+        },
+        { ...ctx.context, transaction }
+      );
+    }
+    return true;
+  });
+}
+
+/**
+ * Remove only the grant automatically created by this feature after unlink succeeds.
+ *
+ * @param ctx the authenticated project management context.
+ * @param collectionId the collection that was successfully unlinked.
+ * @returns whether an automatic edit grant was removed or restored to read.
+ */
+export async function releaseProjectGroup(
+  ctx: APIContext,
+  collectionId: string
+) {
+  return sequelize.transaction(async (transaction) => {
+    const automatic = await GroupMembership.findByPk(
+      projectGroupMembershipId(collectionId),
+      { transaction, lock: transaction.LOCK.UPDATE }
+    );
+    const membership =
+      automatic ||
+      (await GroupMembership.findOne({
+        where: {
+          collectionId,
+          workhubPreviousPermission: CollectionPermission.Read,
+        },
+        transaction,
+        lock: transaction.LOCK.UPDATE,
+      }));
+    if (
+      !membership ||
+      membership.collectionId !== collectionId ||
+      membership.permission !== CollectionPermission.ReadWrite
+    ) {
+      return false;
+    }
+    if (membership.workhubPreviousPermission === CollectionPermission.Read) {
+      membership.permission = CollectionPermission.Read;
+      membership.workhubPreviousPermission = null;
+      await membership.save({ ...ctx.context, transaction });
+      return true;
+    }
+    await GroupMembership.destroyWithCtx(ctx, {
+      where: { id: membership.id },
+      transaction,
+    });
+    return true;
+  });
+}
