+export interface DropRect {
+  left: number;
+  top: number;
+  right: number;
+  bottom: number;
+}
+
+export interface DropColumn extends DropRect {
+  status: string;
+}
+
+/** Pick the column most overlapped by the card, with pointer entry as a fallback.
+ *
+ * @param card - dragged card bounds in viewport coordinates.
+ * @param pointer - current pointer position in viewport coordinates.
+ * @param columns - visible column bounds in board order.
+ * @param source - original task status, which cannot be its own destination.
+ * @return the destination status, or undefined outside the eligible bounds.
+ */
+export function findDropTarget(
+  card: DropRect,
+  pointer: { x: number; y: number },
+  columns: DropColumn[],
+  source: string
+): string | undefined {
+  const candidates = columns.filter(
+    (column) => column.status !== source && column.right > column.left
+  );
+  const hovered = candidates.find(
+    (column) =>
+      pointer.x >= column.left &&
+      pointer.x <= column.right &&
+      pointer.y >= column.top &&
+      pointer.y <= column.bottom
+  );
+  const minimumWidth = Math.min(36, (card.right - card.left) * 0.2);
+  const minimumHeight = Math.min(24, (card.bottom - card.top) * 0.2);
+  let best: string | undefined;
+  let largestOverlap = 0;
+  for (const column of candidates) {
+    const width =
+      Math.min(card.right, column.right) - Math.max(card.left, column.left);
+    const height =
+      Math.min(card.bottom, column.bottom) - Math.max(card.top, column.top);
+    if (width < minimumWidth || height < minimumHeight) {
+      continue;
+    }
+    const overlap = width * height;
+    if (overlap > largestOverlap) {
+      largestOverlap = overlap;
+      best = column.status;
+    }
+  }
+  return best ?? hovered?.status;
+}
