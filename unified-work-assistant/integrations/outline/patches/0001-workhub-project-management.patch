+import {
+  createContext,
+  useCallback,
+  useContext,
+  useEffect,
+  useRef,
+  useState,
+} from "react";
+import { toast } from "sonner";
+import env from "~/env";
+import useStores from "~/hooks/useStores";
+import type Document from "~/models/Document";
+import { client } from "~/utils/ApiClient";
+import WorkhubTaskCreate, { type TaskCreateContext } from ".";
+
+interface SidebarContext {
+  eligibleIds: ReadonlySet<string>;
+  inspect: (collectionId: string, documentId: string) => void;
+  open: (collectionId: string, documentId: string) => Promise<boolean>;
+}
+interface Target {
+  document: Document;
+  context: TaskCreateContext;
+}
+const SidebarTaskContext = createContext<SidebarContext | undefined>(undefined);
+
+/** Provide one task dialog outside the sidebar's virtualized document rows. */
+export function SidebarTaskCreateProvider({
+  children,
+}: {
+  children: React.ReactNode;
+}) {
+  const { documents } = useStores();
+  const [eligibleIds, setEligibleIds] = useState<ReadonlySet<string>>(
+    new Set()
+  );
+  const [target, setTarget] = useState<Target>();
+  const inspected = useRef(new Set<string>());
+  const opening = useRef(false);
+  const mounted = useRef(true);
+  useEffect(() => {
+    mounted.current = true;
+    return () => {
+      mounted.current = false;
+    };
+  }, []);
+
+  const fetchContext = useCallback(
+    async (collectionId: string, documentId: string) => {
+      const response = await client.post<{ data: TaskCreateContext }>(
+        "/workhub.taskCreateInfo",
+        { collectionId, parentDocumentId: documentId },
+        { retry: false }
+      );
+      if (!response?.data) {
+        throw new Error(
+          "업무 등록 여부를 확인하지 못했습니다. 다시 시도하세요."
+        );
+      }
+      if (mounted.current) {
+        setEligibleIds((previous) => {
+          if (previous.has(documentId) === response.data.eligible) {
+            return previous;
+          }
+          const next = new Set(previous);
+          if (response.data.eligible) {
+            next.add(documentId);
+          } else {
+            next.delete(documentId);
+          }
+          return next;
+        });
+      }
+      return response.data;
+    },
+    []
+  );
+
+  const inspect = useCallback(
+    (collectionId: string, documentId: string) => {
+      if (
+        !env.OUTLINE_TASK_CREATION_ENABLED ||
+        inspected.current.has(documentId)
+      ) {
+        return;
+      }
+      inspected.current.add(documentId);
+      void fetchContext(collectionId, documentId).catch(() => {
+        inspected.current.delete(documentId);
+      });
+    },
+    [fetchContext]
+  );
+
+  const open = useCallback(
+    async (collectionId: string, documentId: string) => {
+      if (!env.OUTLINE_TASK_CREATION_ENABLED) {
+        return false;
+      }
+      if (opening.current || target) {
+        return true;
+      }
+      opening.current = true;
+      try {
+        const document = await documents.fetch(documentId);
+        if (
+          document.isDraft ||
+          document.isArchived ||
+          document.isDeleted ||
+          document.parentDocumentId
+        ) {
+          return false;
+        }
+        // Recheck on click so a stale tooltip never grants access or picks another parent.
+        const context = await fetchContext(collectionId, documentId);
+        if (!context.eligible) {
+          return false;
+        }
+        if (mounted.current) {
+          setTarget({ document, context });
+        }
+        return true;
+      } catch (error) {
+        if (mounted.current) {
+          toast.error(
+            error instanceof Error
+              ? error.message
+              : "업무 등록 여부를 확인하지 못했습니다. 다시 시도하세요."
+          );
+        }
+        // Do not create an ordinary document when task eligibility is uncertain.
+        return true;
+      } finally {
+        opening.current = false;
+      }
+    },
+    [documents, fetchContext, target]
+  );
+
+  return (
+    <SidebarTaskContext.Provider value={{ eligibleIds, inspect, open }}>
+      {children}
+      {target && (
+        <WorkhubTaskCreate
+          key={target.document.id}
+          document={target.document}
+          initialContext={target.context}
+          initiallyOpen
+          hideTrigger
+          onClose={() => setTarget(undefined)}
+        />
+      )}
+    </SidebarTaskContext.Provider>
+  );
+}
+
+/** Access sidebar task registration without changing other document row surfaces. */
+export function useSidebarTaskCreate() {
+  return useContext(SidebarTaskContext);
+}
