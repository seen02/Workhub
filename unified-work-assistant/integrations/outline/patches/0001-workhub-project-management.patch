+import Router from "koa-router";
+import {
+  createHash,
+  createHmac,
+  randomUUID,
+  timingSafeEqual,
+} from "node:crypto";
+import { z } from "zod";
+import auth from "@server/middlewares/authentication";
+import validate from "@server/middlewares/validate";
+import timeout from "@server/middlewares/timeout";
+import { rateLimiter } from "@server/middlewares/rateLimiter";
+import { RateLimiterStrategy } from "@server/utils/RateLimiter";
+import type { APIContext } from "@server/types";
+import { BaseSchema } from "./schema";
+import { Collection, Document, User } from "@server/models";
+import { can } from "@server/policies";
+
+const schema = BaseSchema.extend({
+  body: z
+    .object({
+      query: z.string().max(1500).optional(),
+      mode: z.enum(["links", "answer"]).optional(),
+      request_id: z.string().max(100).optional(),
+      collection_id: z.string().uuid().optional(),
+      filters: z
+        .object({
+          document_id: z.string().uuid().optional(),
+          author_id: z.string().uuid().optional(),
+          days: z.number().int().min(0).max(36500).optional(),
+          date_filter: z.enum(["", "day", "week", "month", "year"]).optional(),
+          title_only: z.boolean().optional(),
+        })
+        .strict()
+        .optional(),
+      included: z.boolean().optional(),
+      room_id: z.string().max(100).optional(),
+      collection_ids: z.array(z.string().uuid()).max(100).optional(),
+    })
+    .strict(),
+});
+const router = new Router();
+const accessSchema = BaseSchema.extend({
+  body: z
+    .object({
+      userId: z.string().uuid(),
+      documentIds: z.array(z.string().uuid()).max(100).default([]),
+    })
+    .strict(),
+});
+router.post(
+  "workhub.searchAccess",
+  auth(),
+  timeout(50000),
+  validate(accessSchema),
+  async (ctx: APIContext<z.infer<typeof accessSchema>>) => {
+    const secret = process.env.OUTLINE_WORKHUB_BRIDGE_SECRET;
+    const stamp = ctx.get("X-Workhub-Access-Time"),
+      signature = ctx.get("X-Workhub-Access-Signature");
+    const { userId, documentIds } = ctx.input.body;
+    if (
+      process.env.OUTLINE_AI_SEARCH_ENABLED !== "true" ||
+      !secret ||
+      !ctx.state.auth.user.isAdmin ||
+      Math.abs(Date.now() / 1000 - Number(stamp)) > 60 ||
+      !/^\d+$/.test(stamp)
+    ) {
+      ctx.throw(403, "검색 권한을 확인할 수 없습니다.");
+      return;
+    }
+    const expected = createHmac("sha256", secret)
+      .update([userId, JSON.stringify(documentIds), stamp].join("\n"))
+      .digest("hex");
+    if (
+      signature.length !== expected.length ||
+      !timingSafeEqual(Buffer.from(signature), Buffer.from(expected))
+    ) {
+      ctx.throw(403, "검색 서버 인증이 필요합니다.");
+      return;
+    }
+    const user = await User.findByPk(userId);
+    if (
+      !user ||
+      user.isSuspended ||
+      user.teamId !== ctx.state.auth.user.teamId
+    ) {
+      ctx.throw(403, "활성 Outline 계정이 필요합니다.");
+      return;
+    }
+    const collections = await Collection.scope({
+      method: ["withMembership", user.id],
+    }).findAll({ where: { teamId: user.teamId } });
+    const allowed = collections
+      .filter((c) => can(user, "readDocument", c))
+      .map((c) => c.id);
+    const documents: string[] = [];
+    for (const id of documentIds) {
+      const doc = await Document.findByPk(id, { userId: user.id });
+      if (
+        doc &&
+        doc.publishedAt &&
+        !doc.archivedAt &&
+        !doc.deletedAt &&
+        can(user, "read", doc)
+      ) {
+        documents.push(doc.id);
+      }
+    }
+    ctx.set("Cache-Control", "no-store");
+    ctx.body = { data: { collections: allowed, documents } };
+  }
+);
+for (const action of [
+  "capabilities",
+  "catalog",
+  "include",
+  "sharing",
+  "refresh",
+  "submit",
+  "result",
+  "cancel",
+]) {
+  router.post(
+    `workhub.search.${action}`,
+    auth(),
+    timeout(50000),
+    rateLimiter(RateLimiterStrategy.OneHundredPerMinute),
+    validate(schema),
+    async (ctx: APIContext<z.infer<typeof schema>>) => {
+      if (process.env.OUTLINE_AI_SEARCH_ENABLED !== "true") {
+        ctx.throw(404, "AI 검색이 활성화되지 않았습니다.");
+      }
+      const { user } = ctx.state.auth;
+      const path = `/internal/outline-search/${action}`;
+      const raw = JSON.stringify({
+        ...ctx.input.body,
+        actor: { outlineUserId: user.id, outlineTeamId: user.teamId },
+      });
+      const stamp = Math.floor(Date.now() / 1000).toString();
+      const nonce = randomUUID();
+      const secret = process.env.OUTLINE_WORKHUB_BRIDGE_SECRET;
+      const base = process.env.WORKHUB_INTERNAL_URL;
+      if (!secret || !base) {
+        ctx.throw(503, "AI 검색 연결을 확인하세요.");
+        return;
+      }
+      const signature = createHmac("sha256", secret)
+        .update(
+          [
+            "POST",
+            path,
+            stamp,
+            nonce,
+            createHash("sha256").update(raw).digest("hex"),
+          ].join("\n")
+        )
+        .digest("hex");
+      let response;
+      try {
+        response = await fetch(base + path, {
+          method: "POST",
+          headers: {
+            "Content-Type": "application/json",
+            "X-Workhub-Time": stamp,
+            "X-Workhub-Nonce": nonce,
+            "X-Workhub-Signature": signature,
+          },
+          body: raw,
+          signal: AbortSignal.timeout(45000),
+        });
+      } catch {
+        ctx.throw(503, "검색 서버에 연결하지 못했어요. 다시 시도해 주세요.");
+        return;
+      }
+      const data = (await response.json()) as { detail?: string };
+      if (!response.ok) {
+        ctx.throw(
+          response.status,
+          typeof data.detail === "string"
+            ? data.detail
+            : "검색 요청을 처리하지 못했어요."
+        );
+      }
+      ctx.set("Cache-Control", "no-store");
+      ctx.body = { data };
+    }
+  );
+}
+export default router;
