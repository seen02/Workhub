+    const doc = parser.parse("[[_OUTLINE_TOC_]]\n\n# Title");
+    expect(doc?.firstChild?.type.name).toBe("table_of_contents");
+    expect(parser.parse(serializer.serialize(doc))?.toJSON()).toEqual(
