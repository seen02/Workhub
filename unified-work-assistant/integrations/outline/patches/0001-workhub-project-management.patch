+import Router from "koa-router";
+import { createHash, createHmac, randomUUID } from "node:crypto";
+import { z } from "zod";
+import auth from "@server/middlewares/authentication";
+import validate from "@server/middlewares/validate";
+import { rateLimiter } from "@server/middlewares/rateLimiter";
+import { RateLimiterStrategy } from "@server/utils/RateLimiter";
+import { Collection, Document } from "@server/models";
+import { authorize, can } from "@server/policies";
+import type { APIContext } from "@server/types";
+import { BaseSchema } from "./schema";
+import {
+  releaseProjectGroup,
+  ensureProjectGroup,
+} from "@server/utils/workhubProjectGroup";
+
+const schema = BaseSchema.extend({
+  body: z
+    .object({
+      collectionId: z.string().uuid().optional(),
+      requestId: z.string().uuid().optional(),
+      expectedRevision: z.number().int().min(0).optional(),
+      managerSubject: z.string().uuid().nullable().optional(),
+      deleteTaskList: z.boolean().optional(),
+      expectedParentId: z.string().uuid().nullable().optional(),
+    })
+    .strict(),
+});
+type Request = z.infer<typeof schema>;
+interface BridgeResult {
+  linked?: boolean;
+  operationStatus?: string;
+  result?: { linked?: boolean } | null;
+  connectionGroupRemoved?: boolean;
+  connectionGroupGranted?: boolean;
+  collectionPermission?: string | null;
+  detail?: string | { message?: string };
+  parent?: { id: string } | null;
+  permissions?: { updateManager: boolean; deleteTaskList: boolean };
+}
+const router = new Router();
+const actions = {
+  capabilities: "capabilities",
+  projectConnectionGroup: "connection-group",
+  projectInfo: "info",
+  projectManagers: "managers",
+  projectLink: "link",
+  projectManagerUpdate: "manager",
+  projectUnlinkPreview: "unlink-preview",
+  projectUnlink: "unlink",
+  projectOperation: "operation",
+  projectResume: "resume",
+};
+
+for (const [method, action] of Object.entries(actions)) {
+  router.post(
+    `workhub.${method}`,
+    auth(),
+    rateLimiter(RateLimiterStrategy.OneHundredPerMinute),
+    validate(schema),
+    async (ctx: APIContext<Request>) => {
+      if (process.env.OUTLINE_PROJECT_MANAGEMENT_ENABLED !== "true") {
+        ctx.throw(404, "프로젝트 관리가 활성화되지 않았습니다.");
+      }
+      const { user } = ctx.state.auth;
+      const input = ctx.input.body;
+      let canManageProject = false;
+      let collectionPermission: string | null | undefined;
+      let groupGranted = false;
+      if (input.collectionId) {
+        const collection = await Collection.findByPk(input.collectionId, {
+          userId: user.id,
+          rejectOnEmpty: true,
+        });
+        authorize(user, "readDocument", collection);
+        canManageProject = !!can(user, "update", collection);
+        collectionPermission = collection.permission;
+        if (action === "link") {
+          if (!input.requestId || input.expectedRevision === undefined) {
+            ctx.throw(422, "프로젝트 연결 요청 번호와 버전이 필요합니다.");
+          }
+          groupGranted = await ensureProjectGroup(ctx, collection, {
+            ...input,
+            collectionId: collection.id,
+            requestId: input.requestId,
+            expectedRevision: input.expectedRevision,
+          });
+        }
+      } else if (action !== "capabilities" && action !== "connection-group") {
+        ctx.throw(400, "컬렉션을 선택하세요.");
+      }
+      let canDeleteTaskList = false;
+      if (input.expectedParentId) {
+        const document = await Document.findByPk(input.expectedParentId, {
+          userId: user.id,
+          paranoid: false,
+        });
+        canDeleteTaskList =
+          !!document &&
+          document.collectionId === input.collectionId &&
+          !!(
+            can(user, "delete", document) ||
+            (document.isDeleted && can(user, "restore", document))
+          );
+      }
+      const path = `/internal/outline-projects/${action}`;
+      const raw = JSON.stringify({
+        ...input,
+        actor: {
+          outlineUserId: user.id,
+          outlineTeamId: user.teamId,
+          canManageProject,
+          canCreateCollection: !!can(user, "createCollection", user.team),
+          canDeleteTaskList,
+        },
+      });
+      const timestamp = Math.floor(Date.now() / 1000).toString();
+      const nonce = randomUUID();
+      const secret = process.env.OUTLINE_WORKHUB_BRIDGE_SECRET;
+      const base = process.env.WORKHUB_INTERNAL_URL;
+      if (!secret || !base) {
+        ctx.throw(503, "프로젝트 연동 설정이 필요합니다.");
+        return;
+      }
+      const signature = createHmac("sha256", secret)
+        .update(
+          [
+            "POST",
+            path,
+            timestamp,
+            nonce,
+            createHash("sha256").update(raw).digest("hex"),
+          ].join("\n")
+        )
+        .digest("hex");
+      let response;
+      try {
+        response = await fetch(base + path, {
+          method: "POST",
+          headers: {
+            "Content-Type": "application/json",
+            "X-Workhub-Time": timestamp,
+            "X-Workhub-Nonce": nonce,
+            "X-Workhub-Signature": signature,
+          },
+          body: raw,
+          signal: AbortSignal.timeout(60000),
+        });
+      } catch {
+        ctx.throw(
+          503,
+          "프로젝트 처리 결과를 확인하지 못했습니다. 다시 확인해 주세요." +
+            (groupGranted
+              ? " 그룹의 편집 권한은 설정되었습니다. 같은 요청으로 결과를 확인하세요."
+              : "")
+        );
+        return;
+      }
+      const data: BridgeResult = await response.json();
+      if (!response.ok) {
+        const message =
+          typeof data.detail === "string"
+            ? data.detail
+            : "프로젝트 요청을 처리하지 못했습니다.";
+        ctx.throw(
+          response.status,
+          groupGranted
+            ? `${message} Connect_as_a_project 그룹의 편집 권한은 설정되었습니다. 컬렉션을 다시 만들지 말고 같은 요청으로 재시도하세요.`
+            : message
+        );
+      }
+      data.collectionPermission = collectionPermission;
+      data.connectionGroupGranted = groupGranted;
+      if (action === "unlink-preview" && data.parent && data.permissions) {
+        const document = await Document.findByPk(data.parent.id, {
+          userId: user.id,
+        });
+        data.permissions.deleteTaskList =
+          data.permissions.updateManager &&
+          !!document &&
+          document.collectionId === input.collectionId &&
+          !!can(user, "delete", document);
+      }
+      if (
+        input.collectionId &&
+        (((action === "unlink" || action === "resume") &&
+          data.linked === false) ||
+          (action === "operation" &&
+            data.operationStatus === "completed" &&
+            data.result?.linked === false))
+      ) {
+        try {
+          data.connectionGroupRemoved = await releaseProjectGroup(
+            ctx,
+            input.collectionId
+          );
+        } catch {
+          ctx.throw(
+            503,
+            "프로젝트 연결은 해제했지만 자동 부여한 그룹 권한을 회수하지 못했습니다. 같은 요청으로 다시 확인하세요."
+          );
+        }
+      }
+      ctx.set("Cache-Control", "no-store");
+      ctx.body = { data };
+    }
+  );
+}
+export default router;
