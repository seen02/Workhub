+import { dateError, dateKey, normalizeDate, parseDate } from "./dates";
+
+describe("task dates", () => {
+  it("accepts leap days and rejects overflow or incomplete values", () => {
+    expect(parseDate("2028-02-29")).toBeDefined();
+    for (const value of [
+      "2026-02-29",
+      "2026-04-31",
+      "2026-13-01",
+      "2026-1-01",
+    ]) {
+      expect(parseDate(value)).toBeUndefined();
+    }
+  });
+  it("round trips local calendar days without UTC conversion", () => {
+    expect(dateKey(parseDate("2026-10-01")!)).toBe("2026-10-01");
+  });
+  it("accepts common date notations without turning an invalid date into another day", () => {
+    for (const value of [
+      "20261008",
+      "2026.10.8",
+      "2026/10/8",
+      " 2026-10-08 ",
+    ]) {
+      expect(normalizeDate(value)).toBe("2026-10-08");
+    }
+    for (const value of ["20260230", "2026.2.30", "10/8/2026", "202610"]) {
+      expect(normalizeDate(value)).toBe(value);
+    }
+    expect(dateError("20261009", "2026.10.8")).not.toBe("");
+    expect(dateError("20261001", "2026.10.8")).toBe("");
+  });
+  it("allows unknown deadlines, same-day work, and past work but rejects reversed dates", () => {
+    expect(dateError("2026-10-01", "")).toBe("");
+    expect(dateError("2026-10-01", "2026-10-01")).toBe("");
+    expect(dateError("2025-01-01", "2025-01-02")).toBe("");
+    expect(dateError("2026-10-02", "2026-10-01")).not.toBe("");
+  });
+});
