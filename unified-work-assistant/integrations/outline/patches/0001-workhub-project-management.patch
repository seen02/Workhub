+import type { Node } from "prosemirror-model";
+import { TextSelection, type EditorState } from "prosemirror-state";
+import textBetween from "./textBetween";
+
+/** A text snapshot; positions are hints, never permanent document anchors. */
+export interface TaskSelection {
+  from: number;
+  to: number;
+  quote: string;
+  prefix: string;
+  suffix: string;
+}
+
+/** Check the selected fragment without reading surrounding document content. */
+export function hasTaskSelection(state: EditorState): boolean {
+  const { doc, selection } = state;
+  if (!(selection instanceof TextSelection) || selection.empty) {
+    return false;
+  }
+  let containsTable = false;
+  doc.nodesBetween(selection.from, selection.to, (node) => {
+    if (
+      ["table", "table_row", "table_cell", "table_header"].includes(
+        node.type.name
+      )
+    ) {
+      containsTable = true;
+    }
+  });
+  if (containsTable) {
+    return false;
+  }
+  return !!textBetween(doc, selection.from, selection.to).trim();
+}
+
+/** Capture a text selection before a modal moves focus away from the editor. */
+export function getTaskSelection(
+  state: EditorState
+): TaskSelection | undefined {
+  if (!hasTaskSelection(state)) {
+    return;
+  }
+  const { doc, selection } = state;
+  const quote = textBetween(doc, selection.from, selection.to);
+  return {
+    from: selection.from,
+    to: selection.to,
+    quote,
+    prefix: textBetween(doc, 0, selection.from).slice(-64),
+    suffix: textBetween(doc, selection.to, doc.content.size).slice(0, 64),
+  };
+}
+
+/** Verify saved text, accepting a unique context match after concurrent edits. */
+export function matchesTaskSelection(
+  doc: Node,
+  selection: TaskSelection
+): boolean {
+  const { from, to, quote, prefix, suffix } = selection;
+  if (!quote.trim() || quote.length > 10000 || to <= from) {
+    return false;
+  }
+  if (
+    from >= 0 &&
+    to <= doc.content.size &&
+    textBetween(doc, from, to) === quote &&
+    textBetween(doc, 0, from).endsWith(prefix) &&
+    textBetween(doc, to, doc.content.size).startsWith(suffix)
+  ) {
+    return true;
+  }
+  const plain = textBetween(doc, 0, doc.content.size);
+  let matches = 0;
+  let offset = plain.indexOf(quote);
+  while (offset !== -1) {
+    const end = offset + quote.length;
+    if (
+      plain.slice(0, offset).endsWith(prefix) &&
+      plain.slice(end).startsWith(suffix)
+    ) {
+      matches += 1;
+    }
+    if (matches > 1) {
+      return false;
+    }
+    offset = plain.indexOf(quote, offset + 1);
+  }
+  return matches === 1;
+}
