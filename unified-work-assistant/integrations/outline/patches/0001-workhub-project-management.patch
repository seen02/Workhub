+/** Parse a date-only value without shifting it into another time zone. */
+export function parseDate(value: string): Date | undefined {
+  if (!/^\d{4}-\d{2}-\d{2}$/.test(value)) {
+    return undefined;
+  }
+  const [year, month, day] = value.split("-").map(Number);
+  const result = new Date(year, month - 1, day, 12);
+  return result.getFullYear() === year &&
+    result.getMonth() === month - 1 &&
+    result.getDate() === day
+    ? result
+    : undefined;
+}
+/** Format a calendar selection as a date-only value. */
+export function dateKey(value: Date): string {
+  return `${value.getFullYear()}-${String(value.getMonth() + 1).padStart(2, "0")}-${String(value.getDate()).padStart(2, "0")}`;
+}
+/** Normalize supported date notations while preserving invalid input for correction. */
+export function normalizeDate(value: string): string {
+  const trimmed = value.trim();
+  const compact = /^(\d{4})(\d{2})(\d{2})$/.exec(trimmed);
+  const separated = /^(\d{4})[-/.](\d{1,2})[-/.](\d{1,2})$/.exec(trimmed);
+  const parts = compact ?? separated;
+  if (!parts) {
+    return trimmed;
+  }
+  const candidate = `${parts[1]}-${parts[2].padStart(2, "0")}-${parts[3].padStart(2, "0")}`;
+  return parseDate(candidate) ? candidate : trimmed;
+}
+/** Validate optional dates and their ordering before submitting. */
+export function dateError(start: string, due: string): string {
+  start = normalizeDate(start);
+  due = normalizeDate(due);
+  if ((start && !parseDate(start)) || (due && !parseDate(due))) {
+    return "실제 날짜를 YYYY-MM-DD 형식으로 입력하세요.";
+  }
+  return start && due && start > due
+    ? "마감일은 시작일보다 빠를 수 없습니다."
+    : "";
+}
