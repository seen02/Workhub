+    expect(data.sourceUrl).toBe(source.url);
+    const headers = new Headers(options.headers);
+    const signature = createHmac("sha256", "task-secret")
+      .update(
+        [
+          "POST",
+          "/internal/outline-tasks/create",
+          headers.get("X-Workhub-Time"),
+          headers.get("X-Workhub-Nonce"),
+          createHash("sha256").update(options.body).digest("hex"),
+        ].join("\n")
+      )
+      .digest("hex");
+    expect(headers.get("X-Workhub-Signature")).toBe(signature);
+    expect(String(url)).toBe(
+      "http://workhub.invalid/internal/outline-tasks/create"
+    );
+    expect(ctx.response.get("Cache-Control")).toBe("no-store");
+  });
+  it("rejects changed or unsaved excerpts before reserving a new request", async () => {
+    const body = createBody();
+    body.source.quote = "서버에 없는 내용";
+    await expect(invoke("workhub.taskCreate", body)).rejects.toMatchObject({
+      status: 422,
+    });
+    expect(request).toHaveBeenCalledTimes(1);
+    expect(String(request.mock.calls[0][0])).toMatch(/\/status$/);
+  });
+  it("allows recovery of an immutable reserved snapshot after a source edit", async () => {
+    const body = createBody();
+    source.text = "이미 수정된 내용";
+    request.mockImplementation(async (url) =>
+      Response.json(
+        String(url).endsWith("/status") ? { reserved: true } : { id: "created" }
+      )
+    );
+    await invoke("workhub.taskCreate", body);
+    expect(request).toHaveBeenCalledTimes(2);
+  });
+  it("denies removed write access, a moved source and unpublished sources", async () => {
+    const body = createBody();
+    collection.permission = CollectionPermission.Read;
+    await expect(invoke("workhub.taskCreate", body)).rejects.toMatchObject({
+      status: 403,
+    });
+    expect(request).not.toHaveBeenCalled();
+    collection.permission = CollectionPermission.ReadWrite;
+    source.collectionId = randomUUID();
+    await expect(invoke("workhub.taskCreate", body)).rejects.toMatchObject({
+      status: 422,
+    });
+    source.collectionId = cid;
+    source.publishedAt = null;
+    await expect(
+      invoke("workhub.taskSelectionInfo", { documentId: sourceId })
+    ).rejects.toMatchObject({ status: 422 });
+  });
+  it("keeps ordinary creation independent from source verification", async () => {
+    const { source: selection, ...body } = createBody();
+    void selection;
+    await invoke("workhub.taskCreate", body);
+    expect(request).toHaveBeenCalledTimes(1);
+  });
+  it("does not trust a forged source read policy from the request", async () => {
+    const body = createBody();
+    source.teamId = randomUUID();
+    await expect(
+      invoke("workhub.taskCreate", { ...body, actor: { canReadSource: true } })
+    ).rejects.toMatchObject({ status: 403 });
+    expect(request).not.toHaveBeenCalled();
+  });
+  it("fails closed when task registration is disabled", async () => {
+    vi.stubEnv("OUTLINE_TASK_CREATION_ENABLED", "false");
+    await expect(
+      invoke("workhub.taskSelectionInfo", { documentId: sourceId })
+    ).rejects.toMatchObject({ status: 404 });
+    expect(request).not.toHaveBeenCalled();
+  });
+});
