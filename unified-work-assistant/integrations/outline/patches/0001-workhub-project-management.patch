+import type { AnalyticsTask } from "./types";
+
+/** Add calendar days without depending on the browser time zone. */
+export function addDays(key: string, count: number): string {
+  const date = new Date(key + "T00:00:00Z");
+  date.setUTCDate(date.getUTCDate() + count);
+  return date.toISOString().slice(0, 10);
+}
+/** Monday for a Korean date-only calendar label. */
+export function monday(key: string): string {
+  return addDays(key, -((new Date(key + "T00:00:00Z").getUTCDay() + 6) % 7));
+}
+/** Reject incomplete and reversed task periods. */
+export function hasPeriod(task: AnalyticsTask): boolean {
+  return !!task.start && !!task.due && task.start <= task.due;
+}
+/** Inclusive interval overlap matches the existing Workhub calendar. */
+export function overlaps(
+  task: AnalyticsTask,
+  from: string,
+  to: string
+): boolean {
+  return (
+    hasPeriod(task) &&
+    !!task.start &&
+    !!task.due &&
+    task.start <= to &&
+    task.due >= from
+  );
+}
+/** Visible period and calendar grid boundaries. */
+export function calendarRange(anchor: string, mode: "week" | "month") {
+  const from = mode === "week" ? monday(anchor) : anchor.slice(0, 7) + "-01";
+  const to =
+    mode === "week"
+      ? addDays(from, 6)
+      : new Date(
+          Date.UTC(Number(from.slice(0, 4)), Number(from.slice(5, 7)), 0)
+        )
+          .toISOString()
+          .slice(0, 10);
+  const start = monday(from);
+  const end = addDays(monday(to), 6);
+  const days: string[] = [];
+  for (let key = start; key <= end; key = addDays(key, 1)) {
+    days.push(key);
+  }
+  return { from, to, days };
+}
+/** Maximum simultaneous tasks in a period, rather than the number touched. */
+export function peakTasks(
+  tasks: AnalyticsTask[],
+  from: string,
+  to: string
+): number {
+  let peak = 0;
+  for (let day = from; day <= to; day = addDays(day, 1)) {
+    peak = Math.max(
+      peak,
+      tasks.filter((task) => overlaps(task, day, day)).length
+    );
+  }
+  return peak;
+}
