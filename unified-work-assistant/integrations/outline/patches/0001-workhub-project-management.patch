+import { useCallback, useEffect, useRef, useState } from "react";
+import styled from "styled-components";
+import { v4 as uuid } from "uuid";
+import { client as api } from "~/utils/ApiClient";
+import { errToString } from "@shared/utils/error";
+import type { JSONObject } from "@shared/types";
+
+interface Doc {
+  id: string;
+  title: string;
+  url: string;
+  collection: string;
+  number?: number;
+}
+interface Result {
+  status: string;
+  answer?: string;
+  documents?: Doc[];
+  warnings?: string[];
+  choices?: { id: string; name: string }[];
+}
+interface Collection {
+  id: string;
+  name: string;
+  included: boolean;
+  knowledge: boolean;
+  project: boolean;
+  state: string;
+  documents: number;
+  failed: number;
+  synced_at?: string;
+}
+interface Catalog {
+  collections: Collection[];
+  rooms?: { id: string; name: string; kind: string }[];
+  sharing?: Record<string, string[]>;
+}
+interface Props {
+  query: string;
+  collectionId: string;
+  documentId?: string;
+  userId: string;
+  dateFilter: string;
+  statusFilter: string[];
+  titleOnly: boolean;
+}
+const dates: Record<string, number> = { day: 1, week: 7, month: 30, year: 365 };
+const labels: Record<string, string> = {
+  not_included: "미포함",
+  preparing: "검색 준비 중",
+  partial: "일부 실패",
+  syncing: "갱신 중",
+  ready: "사용 가능",
+};
+const call = async <T,>(action: string, body: JSONObject = {}) =>
+  (await api.post<{ data: T }>(`/workhub.search.${action}`, body)).data;
+
+/** Search permitted knowledge from the existing document search screen. */
+export function KnowledgeSearch(props: Props) {
+  const [enabled, setEnabled] = useState(false),
+    [manage, setManage] = useState(false);
+  const [busy, setBusy] = useState(false),
+    [result, setResult] = useState<Result>(),
+    [error, setError] = useState("");
+  const [follow, setFollow] = useState(""),
+    [history, setHistory] = useState<string[]>([]);
+  const [settings, setSettings] = useState(false),
+    [catalog, setCatalog] = useState<Collection[]>([]),
+    [filter, setFilter] = useState("");
+  const [saving, setSaving] = useState(false);
+  const [rooms, setRooms] = useState<NonNullable<Catalog["rooms"]>>([]),
+    [room, setRoom] = useState("");
+  const [sharing, setSharing] = useState<Record<string, string[]>>({});
+  const seq = useRef(0),
+    job = useRef(""),
+    chosenCollection = useRef("");
+  const key = JSON.stringify(props);
+  const supported =
+    props.statusFilter.includes("published") &&
+    (!props.dateFilter || props.dateFilter in dates);
+  const invalidate = useCallback(() => {
+    seq.current++;
+    if (job.current) {
+      void call("cancel", { request_id: job.current }).catch(() => {});
+      job.current = "";
+    }
+  }, []);
+  useEffect(() => {
+    void call<{ enabled: boolean; manage: boolean }>("capabilities")
+      .then((r) => {
+        setEnabled(r.enabled);
+        setManage(r.manage);
+      })
+      .catch(() => {});
+  }, []);
+  useEffect(() => {
+    invalidate();
+    chosenCollection.current = "";
+    setBusy(false);
+    setResult(undefined);
+    setError("");
+    setFollow("");
+    setHistory([]);
+    return invalidate;
+  }, [key, invalidate]);
+  const cancel = () => {
+    seq.current++;
+    if (job.current) {
+      void call("cancel", { request_id: job.current }).catch(() => {});
+    }
+    job.current = "";
+    setBusy(false);
+  };
+  async function run(
+    question = props.query,
+    collection = chosenCollection.current || props.collectionId
+  ) {
+    if (!question.trim() || busy || !supported) {
+      return;
+    }
+    const current = ++seq.current;
+    const rid = uuid();
+    job.current = rid;
+    setBusy(true);
+    setError("");
+    setResult(undefined);
+    const query = history.length
+      ? `${history.slice(-2).join("\n")}\n후속 질문: ${question}`
+      : question;
+    try {
+      await call("submit", {
+        request_id: rid,
+        query: query.slice(-1500),
+        mode: "answer",
+        ...(collection ? { collection_id: collection } : {}),
+        filters: {
+          ...(props.documentId ? { document_id: props.documentId } : {}),
+          ...(props.userId ? { author_id: props.userId } : {}),
+          date_filter: props.dateFilter,
+          title_only: props.titleOnly,
+        },
+      });
+      for (let n = 0; n < 150; n++) {
+        await new Promise((resolve) => setTimeout(resolve, 2000));
+        if (current !== seq.current) {
+          return;
+        }
+        const value = await call<Result>("result", { request_id: rid });
+        if (current !== seq.current) {
+          return;
+        }
+        if (["queued", "running"].includes(value.status)) {
+          continue;
+        }
+        setResult(value);
+        if (value.status === "succeeded") {
+          chosenCollection.current = collection;
+          setHistory((h) => [...h, question].slice(-3));
+        }
+        setFollow("");
+        return;
+      }
+      void call("cancel", { request_id: rid }).catch(() => {});
+      throw new Error("검색이 오래 걸리고 있어요. 잠시 후 다시 시도해 주세요.");
+    } catch (e) {
+      if (current === seq.current) {
+        setError(errToString(e));
+      }
+    } finally {
+      if (current === seq.current) {
+        setBusy(false);
+        job.current = "";
+      }
+    }
+  }
+  async function load() {
+    setSaving(true);
+    try {
+      const value = await call<Catalog>("catalog");
+      setCatalog(value.collections);
+      setRooms(value.rooms || []);
+      setSharing(value.sharing || {});
+    } catch (e) {
+      setError(errToString(e));
+    } finally {
+      setSaving(false);
+    }
+  }
+  async function include(c: Collection) {
+    setSaving(true);
+    try {
+      const value = await call<{ collections: Collection[] }>("include", {
+        collection_id: c.id,
+        included: !c.knowledge,
+      });
+      setCatalog(value.collections);
+    } catch (e) {
+      setError(errToString(e));
+    } finally {
+      setSaving(false);
+    }
+  }
+  async function share(c: Collection) {
+    setSaving(true);
+    try {
+      const ids = sharing[room] || [];
+      const next = ids.includes(c.id)
+        ? ids.filter((id) => id !== c.id)
+        : [...ids, c.id];
+      await call("sharing", { room_id: room, collection_ids: next });
+      setSharing((s) => ({ ...s, [room]: next }));
+    } catch (e) {
+      setError(errToString(e));
+    } finally {
+      setSaving(false);
+    }
+  }
+  if (!enabled) {
+    return null;
+  }
+  return (
+    <Panel data-testid="ai-search">
+      <Bar>
+        <Primary
+          type="button"
+          disabled={busy || !props.query.trim() || !supported}
+          onClick={() => void run()}
+          data-testid="ai-search-run"
+        >
+          ✦ AI 검색
+        </Primary>
+        {busy && (
+          <>
+            <span role="status">AI 검색 중…</span>
+            <Quiet type="button" onClick={cancel}>
+              중단
+            </Quiet>
+          </>
+        )}
+        {manage && (
+          <Quiet
+            type="button"
+            onClick={() => {
+              setSettings(!settings);
+              if (!settings) {
+                void load();
+              }
+            }}
+          >
+            검색 대상 설정
+          </Quiet>
+        )}
+      </Bar>
+      {!supported && (
+        <Note>
+          AI 검색은 게시된 문서와 지원되는 기간 필터에서 사용할 수 있어요.
+          필터를 변경해 주세요.
+        </Note>
+      )}
+      {supported && (
+        <Note>
+          선택한 범위 중 AI 검색에 포함된 게시 문서를 찾습니다.
+          {props.titleOnly ? " 제목이 일치하는 문서의 본문도 확인합니다." : ""}
+        </Note>
+      )}
+      {error && <p role="alert">{error}</p>}
+      {result && (
+        <div aria-live="polite" data-testid="ai-search-result">
+          {result.answer && <Answer>{result.answer}</Answer>}
+          {result.warnings?.map((w) => (
+            <Note key={w}>{w}</Note>
+          ))}
+          {result.choices?.map((c) => (
+            <Quiet
+              type="button"
+              key={c.id}
+              onClick={() => void run(props.query, c.id)}
+            >
+              {c.name}
+            </Quiet>
+          ))}
+          {!!result.documents?.length && (
+            <Sources aria-label="근거 문서">
+              {result.documents.map((d) => (
+                <li key={d.id}>
+                  <a href={d.url} target="_blank" rel="noopener noreferrer">
+                    {d.number ? `[${d.number}] ` : ""}
+                    {d.title}
+                  </a>
+                  <Note>{d.collection}</Note>
+                </li>
+              ))}
+            </Sources>
+          )}
+          {result.status === "succeeded" && (
+            <Follow
+              onSubmit={(e) => {
+                e.preventDefault();
+                void run(follow);
+              }}
+            >
+              <input
+                aria-label="추가 질문"
+                placeholder="추가로 궁금한 내용을 입력하세요"
+                value={follow}
+                onChange={(e) => setFollow(e.target.value)}
+                maxLength={700}
+              />
+              <Quiet type="submit" disabled={busy || !follow.trim()}>
+                질문하기
+              </Quiet>
+            </Follow>
+          )}
+        </div>
+      )}
+      {settings && (
+        <Settings>
+          <Bar>
+            <strong>AI 검색 대상</strong>
+            <Quiet type="button" disabled={saving} onClick={() => void load()}>
+              새로고침
+            </Quiet>
+          </Bar>
+          <input
+            aria-label="컬렉션 찾기"
+            placeholder="컬렉션 찾기"
+            value={filter}
+            onChange={(e) => setFilter(e.target.value)}
+          />
+          {catalog
+            .filter((c) => c.name.includes(filter))
+            .map((c) => (
+              <Setting key={c.id}>
+                <div>
+                  <strong>{c.name}</strong>
+                  <Note>
+                    {c.project ? "프로젝트 연결 · " : ""}
+                    {labels[c.state] || c.state} · 문서 {c.documents}개
