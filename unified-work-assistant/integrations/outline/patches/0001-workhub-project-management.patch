+import { describe, expect, it } from "vitest";
+import { addDays, calendarRange, overlaps, peakTasks } from "./calendar";
+import type { AnalyticsTask } from "./types";
+
+const task = (start: string | null, due: string | null): AnalyticsTask => ({
