+
+const TaskCard = observer(function TaskCard({ card, store }: CardProps) {
+  const [editing, setEditing] = useState(false);
+  const deadline = store.deadlineBadge(card);
+  const dragRef = useRef<HTMLAnchorElement>(null);
+  const lastDragEnd = useRef(0);
+  const movable =
+    !!card.canMove &&
+    !store.pending &&
+    !store.saving &&
+    !store.editLocked &&
+    !editing;
+  const [{ isDragging }, drag] = useDrag(
+    () => ({
+      type: "workhub-task",
+      item: () => {
+        const bounds = dragRef.current?.getBoundingClientRect();
+        return {
+          id: card.id,
+          width: bounds?.width ?? 0,
+          height: bounds?.height ?? 0,
+        };
+      },
+      canDrag: movable,
+      end: () => {
+        lastDragEnd.current = Date.now();
+      },
+      collect: (monitor) => ({ isDragging: monitor.isDragging() }),
+    }),
+    [card.id, movable]
+  );
+  drag(dragRef);
+  const handleClick = (event: MouseEvent<HTMLAnchorElement>) => {
+    // A drag gesture must never open a document on release.
