+import { forwardRef } from "react";
+import type { ComponentProps } from "react";
+import OutlineButton from "~/components/Button";
+
+type Props = ComponentProps<typeof OutlineButton> & {
+  intent?: "confirm" | "cancel" | "danger" | "secondary";
+};
+
+/**
+ * Shared action colors for custom Workhub screens, using Outline's native button styles.
+ *
+ * @param props the native button properties and action intent.
+ * @param ref the forwarded button reference.
+ * @returns the Outline button with a consistent action color.
+ */
+export const WorkhubButton = forwardRef<HTMLButtonElement, Props>(
+  function WorkhubButton_({ intent, neutral, danger, ...props }, ref) {
+    const resolvedIntent =
+      intent ?? (danger ? "danger" : neutral ? "secondary" : "confirm");
+    return (
+      <OutlineButton
+        {...props}
+        ref={ref}
+        neutral={resolvedIntent === "cancel" || resolvedIntent === "secondary"}
+        danger={resolvedIntent === "danger"}
+        data-action-intent={resolvedIntent}
+      />
+    );
+  }
+);
