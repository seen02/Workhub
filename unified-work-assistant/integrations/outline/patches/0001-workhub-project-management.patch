+    (collectionId && document.collectionId !== collectionId) ||
+    !document.publishedAt ||
+    document.isArchived ||
+    document.isDeleted ||
+    document.template
+  ) {
+    ctx.throw(
+      422,
+      "원문 문서의 위치나 상태가 변경되었습니다. 문서를 다시 열어 선택하세요."
