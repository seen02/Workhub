+    user = User.build({ id: userId, teamId, role: UserRole.Member });
+    user.team = Team.build({ id: teamId });
+    collection = Collection.build({
+      id: cid,
+      teamId,
+      permission: CollectionPermission.ReadWrite,
+    });
+    collection.memberships = [];
+    collection.groupMemberships = [];
+    parent = Document.build({
+      id: parentId,
+      teamId,
+      collectionId: cid,
+      title: "업무 목록",
+      publishedAt: new Date(),
+      revisionCount: 1,
+    });
+    source = Document.build({
+      id: sourceId,
+      teamId,
+      collectionId: cid,
+      title: "회의록",
+      text: "센서 오차를 분석한다.",
+      publishedAt: new Date(),
+      revisionCount: 2,
+    });
+    for (const document of [parent, source]) {
+      document.collection = collection;
+      document.memberships = [];
+      document.groupMemberships = [];
+    }
+    vi.spyOn(Collection, "findByPk").mockResolvedValue(collection);
+    vi.spyOn(Document, "findByPk").mockImplementation(async (id) =>
+      id === sourceId ? source : parent
+    );
+    request.mockReset();
+    request.mockImplementation(async (url) => {
+      const path = String(url);
+      if (path.endsWith("/resolve")) {
+        return Response.json({ parentId });
+      }
+      if (path.endsWith("/status")) {
+        return Response.json({ reserved: false });
+      }
+      if (path.endsWith("/info")) {
+        return Response.json({ eligible: true, parentId });
+      }
+      return Response.json({
+        id: randomUUID(),
+        title: "분석",
+        url: "/doc/created",
+      });
+    });
+    vi.stubGlobal("fetch", request);
+  });
+  afterEach(() => {
+    vi.restoreAllMocks();
+    vi.unstubAllGlobals();
+    vi.unstubAllEnvs();
+  });
+
+  const snapshot = () => {
+    const doc = DocumentHelper.toProsemirror(source);
+    const selection = getTaskSelection(
+      EditorState.create({
+        doc,
+        selection: TextSelection.create(doc, 1, doc.content.size - 1),
+      })
+    );
+    if (!selection) {
+      throw new Error("Missing source selection");
+    }
+    return {
+      ...selection,
+      documentId: sourceId,
+      revision: source.revisionCount,
+    };
+  };
+  const createBody = () => ({
+    collectionId: cid,
+    parentDocumentId: parentId,
+    requestId: randomUUID(),
+    title: "분석",
+    ownerId: "outline:person",
+    notes: "수정한 업무 설명",
+    source: snapshot(),
+  });
+  const invoke = async (method: string, body: object) => {
+    const incoming = new IncomingMessage(new Socket());
+    const ctx = Object.assign(
+      new Koa().createContext(incoming, new ServerResponse(incoming)),
+      {
+        params: {},
+        router,
+        _matchedRoute: method,
+        _matchedRouteName: undefined,
+      }
+    );
+    ctx.state.auth = { user };
+    ctx.input = { body };
+    const handler = router.stack
+      .find((route) => route.path === method)
+      ?.stack.at(-1);
+    if (!handler) {
+      throw new Error("Missing route");
+    }
+    await handler(ctx, async () => {});
+    return ctx;
+  };
