+          (selection.owner === undefined ||
+            task.owner.toLowerCase() === selection.owner)
+      );
+    }
+    const search = this.search.trim().toLowerCase();
+    return tasks.filter(
+      (task) =>
+        !search ||
+        [task.title, task.collectionName, this.name(task.owner)].some((value) =>
+          value.toLowerCase().includes(search)
+        )
+    );
+  }
