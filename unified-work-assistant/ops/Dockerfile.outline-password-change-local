# Build from the local source tree while preserving the current runtime dependencies.
ARG OUTLINE_RUNTIME_IMAGE=unified-work-assistant/outline:daily-reports-menu-finish-20261027
FROM node:26.3.0-bookworm AS build
WORKDIR /opt/outline
RUN apt-get update && apt-get install -y --no-install-recommends cmake python3 make g++ && rm -rf /var/lib/apt/lists/*
RUN npm install -g corepack@0.34.0 && corepack enable
COPY outline-65be53c3eb093a535ce260eb2f2da897bb07a29e/package.json outline-65be53c3eb093a535ce260eb2f2da897bb07a29e/yarn.lock outline-65be53c3eb093a535ce260eb2f2da897bb07a29e/.yarnrc.yml ./
COPY outline-65be53c3eb093a535ce260eb2f2da897bb07a29e/patches ./patches
RUN yarn install --immutable && yarn patch-package
COPY outline-65be53c3eb093a535ce260eb2f2da897bb07a29e/ ./
ENV NODE_OPTIONS=--max-old-space-size=8192
RUN yarn oxfmt app/scenes/Settings/Profile.tsx server/env.ts shared/utils/authentik.ts shared/utils/authentik.test.ts
RUN yarn tsc --noEmit
RUN yarn test --project shared-node shared/utils/authentik.test.ts
RUN yarn build

FROM ${OUTLINE_RUNTIME_IMAGE}
USER root
COPY --from=build --chown=nodejs:nodejs /opt/outline/build /opt/outline/build
COPY --from=build --chown=nodejs:nodejs /opt/outline/server /opt/outline/server
USER nodejs
