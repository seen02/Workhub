ARG BASE_IMAGE=custom-outline/outline:criteria-base-1.0.0
FROM node:26.3.0-bookworm AS frontend
WORKDIR /opt/outline
RUN apt-get update && apt-get install -y --no-install-recommends cmake python3 make g++ && rm -rf /var/lib/apt/lists/*
RUN npm install -g corepack@0.34.0 && corepack enable
COPY outline/package.json outline/yarn.lock outline/.yarnrc.yml ./
COPY outline/patches ./patches
RUN yarn install --immutable && yarn patch-package
COPY outline/ ./
ENV NODE_OPTIONS=--max-old-space-size=8192
RUN yarn tsc --noEmit && yarn vite:build

# Replace only the browser bundle. Keep the original server, Node, dependencies,
# entrypoint, and translations so this update cannot introduce server changes.
FROM ${BASE_IMAGE}
USER root
RUN rm -rf /opt/outline/build/app
COPY --from=frontend --chown=node:node /opt/outline/build/app /opt/outline/build/app
USER node
