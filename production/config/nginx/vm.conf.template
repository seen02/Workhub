map $http_upgrade $connection_upgrade {
    default upgrade;
    '' close;
}
resolver 127.0.0.11 valid=10s ipv6=off;

# The router forwards the public port 21801 to the VM port 80.
# Preserve the incoming Host (including the public port) on upstream requests.
server {
    listen ${HTTP_PORT} default_server;
    server_name ${OUTLINE_DOMAIN};
    client_max_body_size 100m;

    location ^~ /internal/ { return 404; }

    location = /authentik {
        return 302 http://$http_host/authentik/;
    }
    # Users need the login flow, but the admin UI uses the separate admin host.
    # Authentik's own permissions still protect all administrative API actions.
    location = /authentik/if/admin { return 404; }
    location ^~ /authentik/if/admin/ { return 404; }

    # Recover Authentik SPA redirects which omit AUTHENTIK_WEB__PATH.
    location ^~ /flows/ {
        return 302 http://$http_host/authentik$request_uri;
    }
    location ^~ /if/ {
        return 302 http://$http_host/authentik$request_uri;
    }

    location ^~ /authentik/ {
        set $backend "authentik-server:9000";
        proxy_pass http://$backend;
        proxy_http_version 1.1;
        proxy_set_header Host $http_host;
        proxy_set_header X-Forwarded-Host $http_host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_read_timeout 300s;
    }

    location / {
        set $backend "${OUTLINE_UPSTREAM}";
        proxy_pass http://$backend;
        proxy_http_version 1.1;
        proxy_set_header Host $http_host;
        proxy_set_header X-Forwarded-Host $http_host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_read_timeout 300s;
    }
}

server {
    listen ${HTTP_PORT};
    server_name ${AUTH_DOMAIN};

    location = / {
        return 302 http://$http_host/authentik/if/admin/;
    }
    location = /authentik {
        return 302 http://$http_host/authentik/;
    }
    # Recover Authentik SPA redirects which omit AUTHENTIK_WEB__PATH.
    location ^~ /flows/ {
        return 302 http://$http_host/authentik$request_uri;
    }
    location ^~ /if/ {
        return 302 http://$http_host/authentik$request_uri;
    }

    location ^~ /authentik/ {
        set $backend "authentik-server:9000";
        proxy_pass http://$backend;
        proxy_http_version 1.1;
        proxy_set_header Host $http_host;
        proxy_set_header X-Forwarded-Host $http_host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_read_timeout 300s;
    }
    location / { return 404; }
}
