{
  "OUTLINE_PROJECT_MANAGEMENT_ENABLED": "${OUTLINE_PROJECT_MANAGEMENT_ENABLED:-true}",
  "OUTLINE_ANALYTICS_ENABLED": "${OUTLINE_ANALYTICS_ENABLED:-true}",
  "OUTLINE_TASK_CREATION_ENABLED": "${OUTLINE_TASK_CREATION_ENABLED:-true}",
  "OUTLINE_KANBAN_ENABLED": "${OUTLINE_KANBAN_ENABLED:-true}",
  "NODE_ENV": "production",
  "PORT": "3000",
  "WEB_CONCURRENCY": "1",
  "URL": "http://${OUTLINE_DOMAIN}:${HTTP_PORT}",
  "DATABASE_URL": "postgres://outline:${OUTLINE_DB_PASSWORD}@outline-db:5432/outline",
  "PGSSLMODE": "disable",
  "REDIS_URL": "redis://outline-redis:6379",
  "SECRET_KEY": "${OUTLINE_SECRET_KEY}",
  "UTILS_SECRET": "${OUTLINE_UTILS_SECRET}",
  "FILE_STORAGE": "local",
  "FILE_STORAGE_LOCAL_ROOT_DIR": "/var/lib/outline/data",
  "FORCE_HTTPS": "false",
  "ENABLE_UPDATES": "false",
  "OIDC_CLIENT_ID": "${OIDC_CLIENT_ID}",
  "OIDC_CLIENT_SECRET": "${OIDC_CLIENT_SECRET}",
  "OIDC_AUTH_URI": "http://${AUTH_DOMAIN}:${HTTP_PORT}/application/o/authorize/",
  "OIDC_TOKEN_URI": "http://${AUTH_DOMAIN}:${HTTP_PORT}/application/o/token/",
  "OIDC_USERINFO_URI": "http://${AUTH_DOMAIN}:${HTTP_PORT}/application/o/userinfo/",
  "OIDC_LOGOUT_URI": "http://${AUTH_DOMAIN}:${HTTP_PORT}/application/o/custom-outline/end-session/",
  "OIDC_SCOPES": "openid email profile work_groups",
  "OIDC_DISPLAY_NAME": "Custom Outline login",
  "WORKHUB_INTERNAL_URL": "http://workhub:8000",
  "OUTLINE_WORKHUB_BRIDGE_SECRET": "${OUTLINE_WORKHUB_BRIDGE_SECRET}",
  "FILE_STORAGE_UPLOAD_MAX_SIZE": "${FILE_STORAGE_UPLOAD_MAX_SIZE:-52428800}"
}
