# Run: python scripts/configure.py init --mode docker --admin-email you@example.com
COMPOSE_PROJECT_NAME=custom-outline
DEPLOY_MODE=docker
HTTP_PORT=18880
DB_PORT=18832
REDIS_PORT=18879
NATIVE_OUTLINE_PORT=18890
NATIVE_WORKHUB_PORT=18891
OUTLINE_DOMAIN=outline.custom-outline.test
AUTH_DOMAIN=auth.custom-outline.test
OUTLINE_IMAGE=custom-outline/outline:1.0.0
WORKHUB_IMAGE=custom-outline/workhub:1.0.0
AUTHENTIK_IMAGE=ghcr.io/goauthentik/server:2026.8.1
OUTLINE_POSTGRES_IMAGE=postgres:18-alpine
AUTHENTIK_POSTGRES_IMAGE=postgres:16-alpine
REDIS_IMAGE=redis:8-alpine
NGINX_IMAGE=nginx:1.29-alpine
OUTLINE_DB_PASSWORD=
AUTHENTIK_DB_PASSWORD=
OUTLINE_SECRET_KEY=
OUTLINE_UTILS_SECRET=
AUTHENTIK_SECRET_KEY=
AUTHENTIK_BOOTSTRAP_EMAIL=
AUTHENTIK_BOOTSTRAP_PASSWORD=
AUTHENTIK_BOOTSTRAP_TOKEN=
AUTHENTIK_DIRECTORY_TOKEN=
OIDC_CLIENT_ID=custom-outline
OIDC_CLIENT_SECRET=
OUTLINE_API_KEY=
OUTLINE_WORKHUB_TEAM_ID=
OUTLINE_WORKHUB_BRIDGE_SECRET=
OUTLINE_PROJECT_MANAGEMENT_ENABLED=true
OUTLINE_TASK_CREATION_ENABLED=true
OUTLINE_KANBAN_ENABLED=true
OUTLINE_ANALYTICS_ENABLED=true

# Maximum attachment size in bytes (50 MiB).
FILE_STORAGE_UPLOAD_MAX_SIZE=52428800
